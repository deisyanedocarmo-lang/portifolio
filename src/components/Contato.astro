---
// Contato: frase de fechamento e a lista de canais.
import { Image } from 'astro:assets';
import fotoContato from '../imagens/foto-contato-deisyane.jpeg';
import { c, linkDeContato } from '../lib/site';

const { titulo, texto, whatsapp, email, instagram, tiktok, midiaKit } = c.contato;
const canais = [
  whatsapp && { rede: 'WhatsApp', href: linkDeContato('whatsapp'), fora: true },
  email && { rede: 'E-mail', href: linkDeContato('email'), fora: false },
  instagram && { rede: 'Instagram', href: linkDeContato('instagram'), fora: true },
  tiktok && { rede: 'TikTok', href: linkDeContato('tiktok'), fora: true },
  midiaKit && { rede: 'Mídia kit', href: /^https:/.test(midiaKit) ? midiaKit : `/${midiaKit}`, fora: true },
].filter((canal) => !!canal);
---

<section class="secao recuo contato" id="contato" aria-labelledby="contato-titulo">
  <div class="contato-grade">
    <div class="contato-conteudo">
      <p class="kicker">Contato</p>
      <h2 id="contato-titulo">{titulo}</h2>
      {texto && <p class="texto">{texto}</p>}
      <ul class="canais">
        {
          canais.map((canal) => (
            <li>
              <a href={canal.href} {...(canal.fora ? { target: '_blank', rel: 'noopener' } : {})}>
                <span class="rede">
                  {canal.rede === 'WhatsApp' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.3 11.8a8.2 8.2 0 0 1-12.1 7.2L4 20l1.1-4A8.2 8.2 0 1 1 20.3 11.8Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M8.2 8.1c.2-.4.5-.4.7-.4h.4c.2 0 .3.1.4.4l.7 1.6c.1.2.1.4 0 .5l-.5.6c-.2.2-.2.3-.1.5.6 1 1.3 1.7 2.3 2.2.2.1.4.1.5-.1l.7-.8c.2-.2.3-.2.5-.1l1.5.7c.2.1.3.2.3.4 0 .3-.1.9-.5 1.2-.4.4-1 .6-1.6.5-1-.1-2.2-.7-3.5-1.8-1.5-1.3-2.3-2.7-2.5-3.7-.2-.7 0-1.3.3-1.7.2-.3.5-.5.9-.6Z" fill="currentColor"/></svg>}
                  {canal.rede === 'E-mail' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {canal.rede === 'Instagram' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.5" cy="6.7" r="1.1" fill="currentColor"/></svg>}
                  {canal.rede === 'TikTok' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3v11.1a4.1 4.1 0 1 1-3.5-4.05v3.15a1.15 1.15 0 1 0 .5.94V3h3c.3 2.6 1.8 4.1 4 4.5v3.1A8.1 8.1 0 0 1 14 8.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {canal.rede}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <figure class="foto-contato">
      <Image src={fotoContato} alt="Deisyane em um retrato com blusa acetinada" widths={[320, 480, 640]} sizes="(max-width: 759px) 62vw, 260px" loading="lazy" />
    </figure>
  </div>
</section>

<style>
  .contato-grade {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 18rem);
    align-items: center;
    gap: clamp(2rem, 7vw, 6rem);
  }
  .foto-contato {
    width: 100%;
    margin: 0;
    padding: 0.6rem;
    border: 1px solid var(--linha);
    border-radius: 10px;
    background: var(--superficie);
  }
  .foto-contato img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 7px;
  }
  .kicker {
    color: var(--suave);
  }
  h2 {
    margin-top: 0.6rem;
    font-size: calc(clamp(2.25rem, 7vw, 4.25rem) * var(--escala));
    line-height: 1;
  }
  .texto {
    max-width: 34rem;
    margin-top: 1.25rem;
  }
  @media (max-width: 759px) {
    .contato-grade {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .foto-contato {
      width: min(70%, 17rem);
      justify-self: center;
    }
    .kicker,
    h2 {
      text-align: left;
    }
    .texto {
      margin-inline: 0;
      text-align: left;
    }
  }
  .canais {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin-top: clamp(2rem, 5vw, 3rem);
    margin-left: 0;
    padding-left: 0;
    list-style: none;
  }
  .canais a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--linha);
    border-radius: 999px;
    background: var(--superficie);
    text-decoration: none;
  }
  .rede {
    display: inline-flex;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    align-items: center;
    gap: 0.5rem;
  }
  .rede svg { width: 1rem; height: 1rem; flex: 0 0 1rem; }
  .canais a:hover .rede { color: var(--destaque); }
  @media (min-width: 760px) {
    .canais { justify-content: flex-start; }
  }
</style>
