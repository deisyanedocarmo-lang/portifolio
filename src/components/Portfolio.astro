---
// A página inteira. A ordem das seções está aqui; o conteúdo vem de src/data/creator.ts.
import Base from '../layouts/Base.astro';
import Topo from './Topo.astro';
import Videos from './Videos.astro';
import Fotografias from './Fotografias.astro';
import Diferenciais from './Diferenciais.astro';
import Marcas from './Marcas.astro';
import Resultados from './Resultados.astro';
import ComoTrabalho from './ComoTrabalho.astro';
import Valores from './Valores.astro';
import Formatos from './Formatos.astro';
import PerguntasFrequentes from './PerguntasFrequentes.astro';
import Contato from './Contato.astro';
import CampanhaEspecial from './CampanhaEspecial.astro';
import { c, linkDeContato, linkPrincipal, videosDaGrade, type Visual } from '../lib/site';
import PreviewEditor from './PreviewEditor.astro';

interface Props {
  visual?: Visual;
  indexar?: boolean;
  paginaCampanha?: boolean;
  paraPlataformas?: boolean;
}
const { visual, indexar, paginaCampanha = false, paraPlataformas = false } = Astro.props;

// Seção aparece se estiver com `mostrar: true` e tiver conteúdo.
const tem = (secao: { mostrar: boolean } | undefined, ...listas: unknown[][]) =>
  !!secao?.mostrar && listas.some((lista) => lista.length > 0);
const t = c.comoTrabalho;
const [nomePrincipal, ...sobrenome] = c.topo.nome.trim().split(/\s+/);
const linkDosPacotes = linkDeContato('whatsapp', 'Oi, Deisyane! Gostaria de saber mais sobre seus pacotes e valores.') ?? linkPrincipal;

// `link`: aparece no menu do cabeçalho fixo.
const secoes = [
  {
    Componente: Resultados,
    id: 'resultados',
    link: 'Depoimentos',
    mostrar: tem(c.resultados, c.resultados?.numeros ?? [], c.resultados?.prints ?? [], c.resultados?.depoimentos ?? []),
  },
  { Componente: Videos, id: 'videos', link: 'Vídeos', mostrar: tem(c.videos, videosDaGrade) },
  { Componente: Fotografias, id: 'fotografias', link: 'Fotos', mostrar: tem(c.fotografias, c.fotografias?.lista ?? []) },
  { Componente: Valores, id: 'valores', link: 'Pacotes', mostrar: !paraPlataformas && tem(c.valores, c.valores?.pacotes ?? [], c.valores?.avulsos ?? []) },
  { Componente: Formatos, id: 'formatos', link: 'Formatos', mostrar: tem(c.formatos, c.formatos?.lista ?? []) },
  {
    Componente: ComoTrabalho,
    id: 'como-trabalho',
    link: 'Processo',
    mostrar: tem(t, t?.incluso ?? [], t?.prazo ? [t.prazo] : [], t?.direitosDeUso ? [t.direitosDeUso] : []),
  },
  { Componente: Diferenciais, id: 'diferenciais', mostrar: tem(c.diferenciais, c.diferenciais?.lista ?? []) },
  { Componente: PerguntasFrequentes, id: 'perguntas-frequentes', link: 'Dúvidas', mostrar: tem(c.perguntasFrequentes, c.perguntasFrequentes?.lista ?? []) },
  { Componente: Contato, id: 'contato', link: 'Contato', mostrar: true },
].filter((s) => s.mostrar);
---

<Base visual={visual} indexar={indexar}>
  <div class="faixa-rolante" aria-label="Mensagem e contato">
    <div class="faixa-movimento">
      {[0, 1, 2, 3].map((item) => (
        <div class="faixa-grupo" aria-hidden={item > 0 ? 'true' : undefined}>
          <span class="mensagem-faixa" data-preview-text-key="faixa-rolante-texto">CREATOR UGC · {c.topo.nicho} · CONTEÚDO AUTÊNTICO · </span>
          <a class="faixa-orcamento" data-preview-text-key="faixa-rolante-botao" href={linkPrincipal} tabindex={item > 0 ? -1 : undefined}>Quero um orçamento</a>
        </div>
      ))}
    </div>
  </div>
  <header class="barra">
    <div class="recuo conteudo-barra">
      <a class="nome" href={paginaCampanha ? '/' : '#'}>{nomePrincipal}{sobrenome.length > 0 && <span class="sobrenome"> {sobrenome.join(' ')}</span>}<span class="assinatura"> · UGC</span></a>
      <details class="menu-mobile">
        <summary>Menu <span aria-hidden="true">⌄</span></summary>
        <ul class="links-mobile">
          {secoes.filter((s) => s.link).map((s) => (
            <li><a href={paginaCampanha ? `/#${s.id}` : `#${s.id}`}>{s.link}</a></li>
          ))}
          {!paraPlataformas && <li><a class="special-menu-link" href="/edicao-especial/" data-special-menu-link data-preview-text-ignore aria-current={paginaCampanha ? 'page' : undefined} hidden={!import.meta.env.DEV && import.meta.env.MODE !== 'preview' && !paginaCampanha && !c.campanha?.mostrar}>{c.campanha?.nome ?? 'Black Friday'}</a></li>}
        </ul>
      </details>
      <nav aria-label="Seções do portfólio">
        <ul>
          {secoes.filter((s) => s.link).map((s) => (
            <li>
              <a href={paginaCampanha ? `/#${s.id}` : `#${s.id}`}>{s.link}</a>
            </li>
          ))}
          {!paraPlataformas && <li><a class="special-menu-link" href="/edicao-especial/" data-special-menu-link data-preview-text-ignore aria-current={paginaCampanha ? 'page' : undefined} hidden={!import.meta.env.DEV && import.meta.env.MODE !== 'preview' && !paginaCampanha && !c.campanha?.mostrar}>{c.campanha?.nome ?? 'Black Friday'}</a></li>}
        </ul>
      </nav>
    </div>
  </header>
  <main id="conteudo" class="pagina">
    {paginaCampanha ? (
      <CampanhaEspecial />
    ) : (
      <>
        <Topo />
        {tem(c.marcas, c.marcas?.lista ?? []) && <Marcas />}
        {secoes.map(({ Componente }) => <Componente />)}
      </>
    )}
  </main>
  <footer class="recuo rodape">
    <p>© {new Date().getFullYear()} {c.topo.nome}</p>
    {c.modoExemplo && <p>Portfólio de exemplo, com dados fictícios</p>}
  </footer>
  {!paraPlataformas && (
    <a class="cta-pacotes-fixo" href={linkDosPacotes} target="_blank" rel="noopener">
      <span data-preview-text-key="botao-fixo-pacotes">Valores e pacotes</span>
      <span class="cta-seta" aria-hidden="true">↗</span>
    </a>
  )}
  {!paraPlataformas && (import.meta.env.DEV || import.meta.env.MODE === 'preview') && <PreviewEditor />}
</Base>

{!paraPlataformas && <script define:vars={{ campaignDefault: { active: c.campanha?.mostrar ?? false, name: c.campanha?.nome ?? 'Black Friday', start: c.campanha?.inicio ?? '', end: c.campanha?.fim ?? '' }, campaignPreview: import.meta.env.DEV || import.meta.env.MODE === 'preview', campaignPage: paginaCampanha }}>
  const campaignKey = 'deisyane-preview-editor-state-v1';
  const updateSpecialLinks = (override) => {
    let campaign = override;
    if (!campaign) {
      try { campaign = JSON.parse(localStorage.getItem(campaignKey) || '{}').campaign || campaignDefault; }
      catch { campaign = campaignDefault; }
    }
    const now = new Date(); now.setHours(0, 0, 0, 0);
    const starts = campaign.start ? new Date(`${campaign.start}T00:00:00`) : undefined;
    const ends = campaign.end ? new Date(`${campaign.end}T23:59:59`) : undefined;
    const visible = campaignPage || campaignPreview || (campaign.active && (!starts || now >= starts) && (!ends || now <= ends));
    document.querySelectorAll('[data-special-menu-link]').forEach((link) => {
      link.hidden = !visible;
      link.textContent = campaign.name || campaignDefault.name;
    });
  };
  updateSpecialLinks();
  window.addEventListener('special-campaign-updated', (event) => updateSpecialLinks(event.detail));
  window.addEventListener('storage', (event) => { if (event.key === campaignKey) updateSpecialLinks(); });
</script>}

<style>
  /* Alternância quase imperceptível entre branco e off-white para separar as áreas. */
  .pagina > :global(section.secao) {
    position: relative;
    isolation: isolate;
  }
  @media (min-width: 760px) {
    .pagina > :global(section.secao:not(.marcas-trabalhadas)) {
      padding-block: clamp(3rem, 4vw, 3.5rem);
    }
  }
  .pagina > :global(section.secao:nth-child(even of section.secao:not(.marcas-trabalhadas)))::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset-block: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    background: var(--fundo-suave);
    pointer-events: none;
  }
  :global(.pagina h2) {
    color: var(--texto);
  }
  :global(#marcas ~ #resultados) {
    padding-top: clamp(0.75rem, 1.5vw, 1rem);
  }
  /* Faixa contínua de identidade; campanhas sazonais são um bloco independente. */
  .faixa-rolante {
    display: flex;
    align-items: center;
    overflow: hidden;
    min-height: 3.5rem;
    padding-block: 0;
    background: var(--marrom-profundo);
    color: #fff;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .mensagem-faixa {
    flex: 0 0 auto;
    padding-inline: clamp(1.5rem, 4vw, 3.5rem);
    font-weight: 600;
    line-height: 1.3;
  }
  .faixa-movimento { display: flex; align-items: center; width: max-content; min-height: 100%; animation: faixa-rolante 44s linear infinite; }
  .faixa-grupo { display: flex; flex: 0 0 auto; align-items: center; min-height: 100%; }
  .faixa-orcamento {
    position: relative;
    z-index: 1;
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    min-height: 2.2rem;
    margin-right: clamp(1.1rem, 3vw, 2.4rem);
    padding: .45rem 1rem;
    border-radius: 999px;
    background: #F7F5F2;
    color: var(--marrom-profundo);
    font: 600 .72rem/1.2 var(--f-corpo);
    letter-spacing: .035em;
    text-decoration: none;
    white-space: nowrap;
  }
  .faixa-orcamento:hover { background: #fff; }
  .faixa-orcamento:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .cta-pacotes-fixo {
    position: fixed;
    right: clamp(1rem, 3vw, 2.25rem);
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    z-index: 20;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    max-width: calc(100vw - 2rem);
    min-height: 3.25rem;
    padding: 0.75rem 1.15rem;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 999px;
    background: var(--marrom-profundo);
    box-shadow: 0 8px 24px rgb(45 31 25 / 0.22);
    color: #fff;
    font: 600 0.82rem/1.2 var(--f-corpo);
    letter-spacing: 0.025em;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
  }
  .cta-pacotes-fixo:hover { transform: translateY(-2px); background: var(--destaque); box-shadow: 0 11px 28px rgb(45 31 25 / 0.25); }
  .cta-pacotes-fixo:focus-visible { outline: 2px solid var(--destaque); outline-offset: 4px; }
  .cta-seta { font-size: 1.05rem; line-height: 1; }
  @keyframes faixa-rolante {
    to { transform: translateX(-25%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .faixa-movimento { width: 100%; animation: none; }
    .faixa-grupo { width: 100%; flex-wrap: wrap; justify-content: center; gap: .4rem; padding-inline: .5rem; text-align: center; white-space: normal; }
    .faixa-grupo:not(:first-child) { display: none; }
    .mensagem-faixa { white-space: normal; }
    .faixa-rolante { padding-block: .6rem; }
  }
  /* Cabeçalho que acompanha a rolagem, com o nome e o botão de contato sempre à mão. */
  .barra {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--linha);
    background: rgb(255 255 255 / 0.96);
    backdrop-filter: blur(10px);
  }
  .conteudo-barra {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 3.75rem;
  }
  .nome {
    flex: 0 0 auto;
    overflow: hidden;
    font-family: var(--fonte-dmSerif), var(--f-titulo);
    font-weight: 400;
    font-size: calc(1.02rem * var(--escala));
    letter-spacing: var(--espaco-titulo);
    text-transform: var(--caixa-titulo);
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #6B554A;
  }
  .assinatura {
    color: inherit;
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }
  .sobrenome { color: inherit; font-style: normal; }
  nav {
    display: none;
  }
  .menu-mobile { position: relative; }
  .menu-mobile summary {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--linha);
    border-radius: 999px;
    font-size: 0.88rem;
    cursor: pointer;
    list-style: none;
  }
  .menu-mobile summary::-webkit-details-marker { display: none; }
  .links-mobile {
    position: absolute;
    top: calc(100% + 0.65rem);
    right: 0;
    z-index: 20;
    display: grid;
    gap: 0.15rem;
    min-width: 12rem;
    padding: 0.5rem;
    border: 1px solid var(--linha);
    border-radius: 0.75rem;
    background: #fff;
  }
  .links-mobile a { display: block; padding: 0.65rem 0.8rem; font-family: var(--f-titulo); font-size: 1rem; word-spacing: .1em; text-decoration: none; }
  .links-mobile a:hover { background: var(--fundo-suave); }
  nav ul {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.7rem;
  }
  nav li { display: flex; align-items: center; }
  nav a {
    display: block;
    font-family: var(--f-titulo);
    font-size: 0.9rem;
    letter-spacing: 0.015em;
    word-spacing: 0.13em;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
  }
  nav a:hover {
    text-decoration: underline;
  }
  nav .special-menu-link { display: inline-flex; align-items: center; min-height: 2.15rem; padding: 0 .8rem; border-radius: 999px; background: var(--marrom-profundo); color: #fff; font-size: .75rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; text-decoration: none; }
  .links-mobile .special-menu-link { border-radius: .5rem; background: var(--fundo-suave); color: var(--marrom-profundo); font-weight: 700; }
  nav [hidden], .links-mobile [hidden] { display: none !important; }
  .barra .botao {
    flex-shrink: 0;
    min-height: 2.5rem;
    padding: 0.55em 1.1em;
    font-size: 0.76rem;
    padding-inline: 0.8rem;
  }
  .rodape {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: clamp(4rem, 10vw, 7rem);
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--linha);
    font-size: 0.85rem;
    color: var(--suave);
  }
  @media (max-width: 759px) {
    .rodape {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }
  @media (min-width: 900px) {
    .menu-mobile { display: none; }
    nav {
      display: block;
    }
  }
  @media (min-width: 1200px) {
    nav ul { gap: 0.85rem; }
    nav a { font-size: 0.92rem; }
    .barra .botao { padding-inline: 1.1rem; font-size: 0.84rem; }
  }
</style>


