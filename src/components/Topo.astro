---
// Topo: nicho, nome, foto, bio e os botões de contato e de ver os vídeos.
import { Picture } from 'astro:assets';
import { c, linkPrincipal } from '../lib/site';

const [primeiro, ...resto] = c.topo.nome.trim().split(/\s+/);
// O nome encolhe se tiver uma palavra muito comprida, para nunca sair da tela.
const letras = Math.max(...c.topo.nome.split(/\s+/).map((p) => p.length), 4);
---

<section class="topo" id="sobre" aria-labelledby="nome" style={`--letras:${letras}`}>
<div class="recuo capa">
  <div class="titulo">
    <p class="kicker">{c.topo.nicho}</p>
    <h1 id="nome">{primeiro}{resto.length > 0 && <em>{resto.join(' ')}</em>}</h1>
    {c.topo.chamada && <p class="creator-hook">{c.topo.chamada}</p>}
  </div>
  <figure class="foto">
    <Picture
      src={c.topo.foto}
      alt={c.topo.fotoDescricao}
      widths={[360, 540, 720, 1080]}
      sizes="(min-width: 860px) 34vw, 80vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
    />
  </figure>
  <div class="intro">
    <p class="bio">{c.topo.bio}</p>
    <div class="acoes">
      <a class="botao" href={linkPrincipal}>{c.topo.botao.texto}</a>
    </div>
  </div>
</div>
</section>

<style>
  .capa {
    display: grid;
    gap: 1.5rem;
    padding-block: clamp(3rem, 7vw, 5.75rem);
  }
  .titulo {
    /* O nome mede a própria coluna (100cqi) para nunca quebrar no meio da palavra. */
    container-type: inline-size;
  }
  .kicker {
    margin: 0 0 1.3rem;
    color: var(--suave);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h1 {
    font-size: min(calc(clamp(3.3rem, 13vw, 7.5rem) * var(--escala)), calc(100cqi / (var(--letras) * var(--letra))));
    line-height: 0.9;
  }
  h1 em {
    display: block;
    font-style: normal;
    color: var(--destaque);
  }
  h1 { color: #211D1A; }
  .creator-hook {
    max-width: 30ch;
    margin: 1.1rem 0 0;
    color: var(--texto);
    font-family: var(--f-titulo);
    font-style: var(--italico);
    font-size: clamp(1.2rem, 2.2vw, 1.55rem);
    line-height: 1.3;
  }
  .foto {
    width: min(84%, 25rem);
    padding: 0.55rem;
    border: 1px solid var(--linha);
    border-radius: 10px;
    background: var(--superficie);
    box-shadow: none;
  }
  .foto :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: max(var(--raio), 10px);
  }
  .bio {
    max-width: 32rem;
    margin-bottom: 1.75rem;
    font-size: 1.08rem;
    color: var(--suave);
  }
  .acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  /* Celular: tudo centralizado, com a foto no meio. */
  @media (max-width: 859px) {
    .capa {
      grid-template-areas: 'foto' 'titulo' 'intro';
      justify-items: center;
      text-align: left;
    }
    .foto { grid-area: foto; }
    .titulo { grid-area: titulo; }
    .intro { grid-area: intro; }
    /* O nome precisa da largura toda: ele mede a coluna para escolher o tamanho. */
    .titulo,
    .intro {
      justify-self: stretch;
    }
    /* Foto menor e botão antes da bio: nome, frase e botão cabem na primeira tela. */
    .capa {
      gap: 1.1rem;
      padding-block: 1.5rem 2.75rem;
    }
    .foto {
      width: min(62%, 15.5rem);
      padding: 0.4rem;
    }
    .kicker {
      margin-bottom: 0.8rem;
      font-size: 0.78rem;
    }
    .intro {
      display: flex;
      flex-direction: column;
    }
    .acoes {
      order: -1;
      justify-content: flex-start;
      margin-bottom: 1.5rem;
    }
    .bio {
      margin: 0;
    }
  }
  @media (min-width: 860px) {
    .capa {
      grid-template-columns: 1.2fr 0.8fr;
      grid-template-areas: 'titulo foto' 'intro foto';
      column-gap: clamp(2.5rem, 7vw, 6.5rem);
      align-items: center;
    }
    .titulo {
      grid-area: titulo;
    }
    .foto {
      grid-area: foto;
      width: min(100%, 27rem);
      justify-self: end;
      align-self: center;
      transform: none;
    }
    .intro {
      grid-area: intro;
      align-self: start;
    }
  }
</style>
