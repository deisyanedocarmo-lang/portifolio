---
// Grade única de vídeos com filtros por nicho; todos aparecem inicialmente.
import Cabecalho from './Cabecalho.astro';
import VideoCard from './VideoCard.astro';
import { c, videosDaGrade, chaveDoNicho } from '../lib/site';

const v = c.videos!;
const nichos = [...new Map(
  videosDaGrade
    .filter((video) => video.nicho)
    .map((video) => [chaveDoNicho(video.nicho!), video.nicho!]),
).entries()];
---

<section class="secao recuo" id="videos" aria-labelledby="videos-titulo" data-video-gallery>
  <Cabecalho rotulo="Portfólio" titulo={v.titulo} id="videos-titulo" previewTextKey="section-videos-title" />
  {v.texto && <p class="texto" data-preview-text-key="section-videos-intro">{v.texto}</p>}
  <nav class="filtros" aria-label="Filtrar vídeos por nicho">
    <button class="filtro ativo" type="button" data-filter="todos" aria-pressed="true">Todos</button>
    {nichos.map(([chave, nome]) => (
      <button class="filtro" type="button" data-filter={chave} aria-pressed="false">{nome}</button>
    ))}
  </nav>
  <ul class="grade">
    {videosDaGrade.map((video) => (
      <li data-video-item data-nicho={video.nicho ? chaveDoNicho(video.nicho) : 'outros'}>
        <VideoCard video={video} />
      </li>
    ))}
  </ul>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-video-gallery]').forEach((gallery) => {
    const nav = gallery.querySelector<HTMLElement>('.filtros');
    const cards = () => [...gallery.querySelectorAll<HTMLElement>('[data-video-item]')];
    const applyFilter = (selected: string) => {
      const filters = [...gallery.querySelectorAll<HTMLButtonElement>('[data-filter]')];
      filters.forEach((button) => {
        const active = button.dataset.filter === selected;
        button.classList.toggle('ativo', active);
        button.setAttribute('aria-pressed', String(active));
      });
      cards().forEach((card) => {
        card.hidden = card.dataset.previewRemoved === 'true' || (selected !== 'todos' && card.dataset.nicho !== selected);
      });
    };
    const bindFilter = (filter: HTMLButtonElement) => {
      if (filter.dataset.filterBound) return;
      filter.dataset.filterBound = 'true';
      filter.addEventListener('click', () => applyFilter(filter.dataset.filter || 'todos'));
    };
    const refreshFilters = () => {
      if (!nav) return;
      const activeFilter = nav.querySelector<HTMLButtonElement>('.filtro.ativo')?.dataset.filter || 'todos';
      const labels = new Map([...nav.querySelectorAll<HTMLButtonElement>('[data-filter]')].map((button) => [button.dataset.filter || '', button.textContent?.trim() || '']));
      const used = new Set(cards()
        .filter((card) => card.dataset.previewRemoved !== 'true')
        .map((card) => card.dataset.nicho || 'outros')
        .filter((key) => key !== 'todos'));
      nav.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => {
        const key = button.dataset.filter || '';
        if (key !== 'todos' && !used.has(key)) button.remove();
      });
      const existing = new Set([...nav.querySelectorAll<HTMLButtonElement>('[data-filter]')].map((button) => button.dataset.filter));
      [...used].sort((left, right) => {
        const leftLabel = cards().find((card) => card.dataset.nicho === left)?.dataset.nichoLabel || left.replace(/-/g, ' ');
        const rightLabel = cards().find((card) => card.dataset.nicho === right)?.dataset.nichoLabel || right.replace(/-/g, ' ');
        return leftLabel.localeCompare(rightLabel, 'pt-BR');
      }).forEach((key) => {
        if (existing.has(key)) return;
        const label = cards().find((card) => card.dataset.nicho === key)?.dataset.nichoLabel || key.replace(/-/g, ' ');
        const button = document.createElement('button');
        button.className = 'filtro';
        button.type = 'button';
        button.dataset.filter = key;
        button.setAttribute('aria-pressed', 'false');
        button.textContent = label;
        nav.append(button);
        bindFilter(button);
      });
      [...nav.querySelectorAll<HTMLButtonElement>('[data-filter]:not([data-filter="todos"])')]
        .sort((left, right) => left.textContent!.localeCompare(right.textContent!, 'pt-BR'))
        .forEach((button) => nav.append(button));
      applyFilter(used.has(activeFilter) || activeFilter === 'todos' ? activeFilter : 'todos');
    };
    gallery.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(bindFilter);
    window.addEventListener('video-filters-refresh', refreshFilters);
    refreshFilters();
  });
</script>

<style is:global>
  #videos .texto {
    max-width: 34rem;
    margin: -0.75rem 0 1.5rem;
    color: var(--suave);
  }
  #videos .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
  }
  #videos .filtro {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.4rem;
    padding: 0.45rem 1rem;
    border: 1px solid var(--destaque);
    border-radius: 999px;
    background: var(--destaque);
    color: var(--botao-texto);
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  #videos .filtro:hover { filter: brightness(.94); }
  #videos .filtro.ativo {
    border-color: var(--marrom-profundo);
    box-shadow: 0 0 0 1px var(--marrom-profundo);
  }
  #videos .filtro:focus-visible {
    outline: 2px solid var(--texto);
    outline-offset: 3px;
  }
  #videos .grade {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  #videos .grade li[hidden] { display: none; }
  /* Celular: vídeos grandes num carrossel de deslizar para o lado, como no Reels.
     O próximo vídeo aparece um pouco na borda, mostrando que dá para deslizar. */
  @media (max-width: 639px) {
    #videos .grade {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 74%;
      gap: 0.85rem;
      margin: 0 -1rem;
      padding: 0.25rem 1rem 0.75rem;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 1rem;
      scrollbar-width: none;
      list-style: none;
    }
    #videos .grade::-webkit-scrollbar { display: none; }
    #videos .grade > li { scroll-snap-align: start; }
  }
  @media (max-width: 759px) {
    #videos .texto { margin-inline: 0; text-align: left; }
    #videos .filtros { justify-content: flex-start; }
    #videos .filtro { min-height: 2.25rem; font-size: 0.85rem; }
  }
  @media (min-width: 640px) {
    #videos .grade { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  }
  @media (min-width: 1024px) {
    #videos .grade { max-width: 68rem; margin-inline: auto; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  }
</style>
