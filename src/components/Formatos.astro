---
import Cabecalho from './Cabecalho.astro';
import { c } from '../lib/site';

const formatos = c.formatos!;
---

<section class="secao recuo" id="formatos" aria-labelledby="formatos-titulo">
  <Cabecalho rotulo="Possibilidades" titulo={formatos.titulo} id="formatos-titulo" previewTextKey="formatos-titulo-v2" />
  <ul class="grade">
    {formatos.lista.map(({ nome, detalhe }, index) => (
      <li class="item">
        <div class="item-cabecalho">
          <span class="numero" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3>{nome}</h3>
        </div>
        {detalhe && <p>{detalhe}</p>}
      </li>
    ))}
  </ul>
</section>

<style>
  .grade { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(0.75rem, 1.8vw, 1.15rem); margin: 0; padding: 0; list-style: none; }
  .item { position: relative; display: grid; align-content: start; gap: 1rem; min-height: 12rem; padding: clamp(1rem, 2vw, 1.4rem); overflow: hidden; border: 1px solid var(--linha); border-radius: max(var(--raio), 1rem); background: var(--superficie); box-shadow: 0 8px 24px rgb(75 53 43 / 0.045); transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease; }
  .item::before { content: ''; width: 2.25rem; height: 2px; background: var(--destaque); }
  .item:hover { transform: translateY(-2px); border-color: var(--destaque); box-shadow: 0 12px 28px rgb(75 53 43 / 0.08); }
  .item-cabecalho { display: flex; align-items: baseline; gap: 0.7rem; }
  .numero { flex: 0 0 auto; color: var(--destaque); font-size: 0.68rem; font-weight: 600; letter-spacing: 0.12em; }
  .item h3 { margin: 0; color: var(--texto); font-family: var(--f-titulo); font-size: calc(clamp(1.08rem, 1.5vw, 1.35rem) * var(--escala)); font-weight: var(--peso-titulo); letter-spacing: var(--espaco-titulo); line-height: 1.15; }
  .item p { max-width: 29rem; margin: 0; color: var(--suave); font-family: var(--f-corpo); font-size: 0.88rem; line-height: 1.6; }
  @media (max-width: 980px) { .grade { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .grade { grid-template-columns: 1fr; } .item { min-height: 0; } }
</style>
