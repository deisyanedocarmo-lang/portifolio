---
// Cabeçalho das seções: um rótulo pequeno em cima e o título.
interface Props {
  rotulo?: string;
  titulo: string;
  id: string;
  previewTextKey?: string;
}
const { rotulo, titulo, id, previewTextKey } = Astro.props;
---

<header class="cabecalho">
  {rotulo && <p class="kicker">{rotulo}</p>}
  <h2 id={id} data-preview-text-key={previewTextKey || `heading-${id}`}>{titulo}</h2>
</header>

<style>
  .cabecalho {
    display: grid;
    gap: 0.6rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
  }
  .kicker {
    color: var(--suave);
  }
  h2 {
    font-size: calc(clamp(1.9rem, 5vw, 3rem) * var(--escala));
    line-height: 1.05;
  }
</style>
