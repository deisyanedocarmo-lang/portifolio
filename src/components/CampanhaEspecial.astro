---
import { c, linkDeContato } from '../lib/site';

const campaign = c.campanha ?? { mostrar: false, nome: 'Black Friday', chamada: 'Uma edição especial para sua marca', texto: '', botao: 'Quero receber os pacotes', inicio: '', fim: '', pacotes: [] };
const defaults = {
  active: campaign.mostrar,
  name: campaign.nome,
  headline: campaign.chamada,
  description: campaign.texto ?? '',
  start: campaign.inicio ?? '',
  end: campaign.fim ?? '',
  packages: Array.from({ length: 3 }, (_, index) => ({
    name: campaign.pacotes?.[index]?.nome ?? '',
    detail: campaign.pacotes?.[index]?.detalhe ?? '',
    price: campaign.pacotes?.[index]?.preco ?? '',
  })),
};
const whatsapp = c.contato.whatsapp?.numero.replace(/\D/g, '') ?? '';
const linkWhatsApp = linkDeContato('whatsapp', campaign.mensagemWhatsapp || `Oi, Deisyane! Quero conhecer os pacotes da edição ${campaign.nome}.`) ?? '#pacotes';
const preview = import.meta.env.DEV || import.meta.env.MODE === 'preview';
---

<div class="special-page" data-special-page data-defaults={JSON.stringify(defaults)} data-preview={preview ? 'true' : 'false'} data-whatsapp={whatsapp}>
      <section class="hero" id="inicio" aria-labelledby="special-title">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> Edição especial · por tempo limitado</p>
          <h1 id="special-title" data-special-name>{campaign.nome}</h1>
          <p class="tagline" data-special-headline>{campaign.chamada}</p>
          <p class="intro" data-special-description>{campaign.texto || 'Conheça os pacotes especiais desta edição e peça as informações direto pelo WhatsApp.'}</p>
          <a class="primary-cta" data-whatsapp-cta href={linkWhatsApp}>Quero conhecer os pacotes <span aria-hidden="true">↗</span></a>
          <p class="fine-print">Converse comigo para receber os detalhes da edição.</p>
        </div>
        <div class="package-area" id="pacotes">
          <div class="package-heading"><p>Pacotes especiais</p></div>
          <ol class="packages" data-special-packages>
            {defaults.packages.map((item, index) => (
              <li class="package-card">
                <span class="package-number">PACOTE {String(index + 1).padStart(2, '0')}</span>
                <div><h2 hidden={!item.name}>{item.name}</h2><p>{item.detail || 'Consulte os detalhes pelo WhatsApp.'}</p></div>
                {item.price && <strong class="package-price">{item.price}</strong>}
              </li>
            ))}
          </ol>
        </div>
      </section>

      <p class="expired-message" data-campaign-expired hidden>Esta edição especial está fora do período de divulgação.</p>
    </div>

<script>
  const page = document.querySelector<HTMLElement>('[data-special-page]');
  const defaults = JSON.parse(page?.dataset.defaults || '{}') as {
    active: boolean; name: string; headline: string; description: string; start: string; end: string;
    packages: { name: string; detail: string; price: string }[];
  };
  const key = 'deisyane-preview-editor-state-v1';
  const normalize = (value: string) => value.trim();
  const campaignState = () => {
    try { return JSON.parse(localStorage.getItem(key) || '{}').campaign || defaults; } catch { return defaults; }
  };
  const inPeriod = (campaign: typeof defaults) => {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const start = campaign.start ? new Date(`${campaign.start}T00:00:00`) : undefined;
    const end = campaign.end ? new Date(`${campaign.end}T23:59:59`) : undefined;
    return (!start || today >= start) && (!end || today <= end);
  };
  const renderCampaign = (campaign = campaignState()) => {
    if (!page) return;
    const previewMode = page.dataset.preview === 'true';
    const available = previewMode || (campaign.active && inPeriod(campaign));
    page.querySelector<HTMLElement>('[data-campaign-expired]')!.hidden = available;
    page.querySelectorAll<HTMLElement>('.hero').forEach((section) => { section.hidden = !available; });
    if (!available) return;
    page.querySelectorAll<HTMLElement>('[data-special-name]').forEach((node) => { node.textContent = campaign.name || 'Edição especial'; });
    page.querySelector<HTMLElement>('[data-special-headline]')!.textContent = campaign.headline || `Uma edição especial para sua marca`;
    page.querySelector<HTMLElement>('[data-special-description]')!.textContent = campaign.description || 'Conheça os pacotes especiais desta edição e peça as informações direto pelo WhatsApp.';
    const phoneNumber = page.dataset.whatsapp;
    if (phoneNumber) {
      const message = campaign.name === defaults.name
        ? `Oi, Deisyane! Quero conhecer os pacotes da edição ${campaign.name}.`
        : `Oi, Deisyane! Quero conhecer os pacotes da edição ${campaign.name || 'especial'}.`;
      const url = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
      page.querySelectorAll<HTMLAnchorElement>('[data-whatsapp-cta]').forEach((link) => { link.href = url; });
    }
    const cards = [...page.querySelectorAll<HTMLElement>('.package-card')];
    const packages = Array.from({ length: 3 }, (_, index) => campaign.packages?.[index] ?? { name: '', detail: '', price: '' });
    packages.forEach((item, index) => {
      const card = cards[index];
      if (!card) return;
      const name = normalize(item.name);
      const title = card.querySelector<HTMLElement>('h2')!;
      title.hidden = !name;
      title.textContent = name;
      card.querySelector('p')!.textContent = normalize(item.detail) || 'Consulte os detalhes pelo WhatsApp.';
      let price = card.querySelector<HTMLElement>('.package-price');
      if (normalize(item.price)) {
        if (!price) { price = document.createElement('strong'); price.className = 'package-price'; card.append(price); }
        price.textContent = item.price;
      } else price?.remove();
    });
  };
  renderCampaign();
  window.addEventListener('special-campaign-updated', (event) => renderCampaign((event as CustomEvent).detail));
  window.addEventListener('storage', (event) => { if (event.key === key) renderCampaign(); });
</script>

<style>
  .special-page { min-height: 100vh; background: var(--fundo); color: var(--texto); }
  .special-header { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 5rem; padding: .7rem clamp(1rem, 6vw, 5.5rem); border-bottom: 1px solid var(--linha); background: rgb(255 255 255 / .94); backdrop-filter: blur(12px); }
  .brand { color: var(--texto); font-family: var(--f-titulo); font-size: 1.25rem; text-decoration: none; white-space: nowrap; }
  .brand span { color: var(--suave); font: 500 .7rem var(--f-corpo); }
  .special-header nav { display: flex; align-items: center; gap: clamp(.5rem, 2.6vw, 2rem); }
  .special-header nav a,.header-cta { color: var(--texto); font-size: .76rem; letter-spacing: .12em; text-decoration: none; text-transform: uppercase; white-space: nowrap; }
  .special-header nav .active-pill { padding: .75rem 1rem; border-radius: 999px; background: var(--marrom-profundo); color: #fff; }
  .header-cta { padding: .8rem 1rem; border: 1px solid var(--linha); border-radius: 999px; font-weight: 600; }
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(19rem, .82fr); align-items: center; gap: clamp(2rem, 7vw, 6rem); min-height: 34rem; padding: clamp(3.5rem, 8vw, 7rem) clamp(1.25rem, 9vw, 8rem); background: linear-gradient(120deg, #4B352B 0%, #3d2b24 100%); color: #fffaf5; }
  .hero-copy { max-width: 40rem; }
  .eyebrow { display: flex; align-items: center; gap: .65rem; margin: 0 0 1.3rem; color: #e3c7aa; font-size: .7rem; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; }
  .eyebrow span { width: .45rem; height: .45rem; border-radius: 50%; background: #c89b72; }
  .hero h1 { max-width: 11ch; margin: .4rem 0 .65rem; color: #f8eee3; font-family: var(--f-titulo); font-size: clamp(3.6rem, 8vw, 7.1rem); font-weight: var(--peso-titulo); letter-spacing: -.055em; line-height: .95; }
  .tagline { max-width: 34rem; margin: 0 0 1rem; color: #e4b98f; font-family: var(--f-titulo); font-size: clamp(1.4rem, 2.6vw, 2.15rem); line-height: 1.2; }
  .intro { max-width: 34rem; margin: 0; color: #eee5dd; font-size: clamp(.95rem, 1.25vw, 1.08rem); line-height: 1.65; }
  .primary-cta { display: inline-flex; align-items: center; gap: 1rem; margin-top: 2rem; padding: 1rem 1.4rem; border-radius: 999px; background: #f7f3ed; color: #2d211c; font-size: .76rem; font-weight: 700; letter-spacing: .13em; text-decoration: none; text-transform: uppercase; }
  .fine-print { margin-top: .8rem; color: #ddd0c6; font-size: .76rem; }
  .package-area { display: grid; gap: .75rem; }
  .package-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding: 0 .35rem .2rem; color: #f8eee3; }
  .package-heading p { margin: 0; font-family: var(--f-titulo); font-size: 1.45rem; }
  .packages { display: grid; gap: .8rem; margin: 0; padding: 0; list-style: none; }
  .package-card { display: grid; grid-template-columns: auto minmax(0,1fr); align-items: center; gap: .9rem; min-height: 6.1rem; padding: 1.05rem 1.25rem; border: 1px solid rgb(255 255 255 / .18); border-radius: 1.15rem; background: rgb(255 255 255 / .055); }
  .package-number { padding-right: .8rem; border-right: 1px solid rgb(255 255 255 / .2); color: #d4a77d; font-size: .64rem; font-weight: 700; letter-spacing: .14em; white-space: nowrap; }
  .package-card h2 { margin: 0; color: #fffaf5; font-family: var(--f-titulo); font-size: 1.3rem; font-weight: var(--peso-titulo); line-height: 1.1; }
  .package-card p { margin: .4rem 0 0; color: #e4d9d0; font-size: .78rem; line-height: 1.4; }
  .package-price { grid-column: 2; color: #f1d1ad; font-size: .9rem; }
  .expired-message { max-width: 50rem; margin: 6rem auto; padding: 2rem; border: 1px solid var(--linha); border-radius: 1rem; color: var(--suave); text-align: center; }
  [hidden] { display: none !important; }
  .special-page footer { display: flex; justify-content: space-between; gap: 1rem; padding: 1.4rem clamp(1.25rem, 9vw, 8rem); border-top: 1px solid var(--linha); color: var(--suave); font-size: .78rem; }
  .special-page footer a { color: inherit; text-decoration: none; }
  @media (max-width: 900px) {
    .special-header { flex-wrap: wrap; }
    .special-header nav { order: 3; width: 100%; justify-content: center; padding-bottom: .35rem; }
    .hero { grid-template-columns: 1fr; gap: 2.5rem; }
    .hero h1 { max-width: 13ch; }
    .package-area { max-width: 42rem; }
  }
  @media (max-width: 560px) {
    .special-header { min-height: 4.2rem; padding: .7rem 1rem; }
    .brand { font-size: 1.05rem; }
    .header-cta { padding: .65rem .75rem; font-size: .63rem; }
    .special-header nav { justify-content: flex-start; gap: .55rem; overflow-x: auto; }
    .special-header nav a { font-size: .62rem; letter-spacing: .08em; }
    .special-header nav .active-pill { padding: .65rem .8rem; }
    .hero { min-height: 0; padding: 3.3rem 1.2rem; }
    .hero h1 { font-size: clamp(3.5rem, 17vw, 5.3rem); }
    .package-heading { align-items: flex-start; flex-direction: column; gap: .3rem; }
    .package-card { grid-template-columns: 1fr; gap: .55rem; padding: 1rem; }
    .package-number { width: fit-content; padding: 0 0 .35rem; border-right: 0; border-bottom: 1px solid rgb(255 255 255 / .2); }
    .package-price { grid-column: 1; }
    .special-page footer { flex-direction: column; align-items: center; text-align: center; }
  }
</style>
