---
import { c } from '../lib/site';
const campaignDefaults = c.campanha ?? { mostrar: false, nome: 'Black Friday', chamada: '', texto: '', botao: 'Quero receber os pacotes', inicio: '', fim: '', pacotes: [] };
---

<aside class="preview-editor" data-preview-editor aria-label="Edição da prévia" data-campaign-defaults={JSON.stringify(campaignDefaults)}>
  <button class="editor-launcher" type="button" data-editor-open aria-expanded="false">Editar portfólio</button>
  <div class="editor-file-inputs" aria-hidden="true">
    <input class="editor-file-input" type="file" accept="video/*,.mp4,.m4v,.mov,.3gp,.3g2,.webm,.avi,.mkv,application/octet-stream" multiple data-editor-video />
    <input class="editor-file-input" type="file" accept="image/*" multiple data-editor-photo />
    <input class="editor-file-input" type="file" accept="image/*" multiple data-editor-testimonial />
    <input class="editor-file-input" type="file" accept="image/png,image/jpeg,image/webp" multiple data-editor-logo />
  </div>
  <section class="editor-panel" data-editor-panel hidden aria-label="Ferramentas de edição">
    <header class="editor-panel-header" aria-label="Arraste para mover o painel">
      <div><strong>Adicionar ao portfólio</strong><span>Inclua fotos, depoimentos, logos e vídeos</span></div>
      <button type="button" data-editor-close aria-label="Minimizar painel">×</button>
    </header>
    <div class="editor-actions">
      <button type="button" data-editor-text>Editar títulos e frases</button>
      <button type="button" data-editor-save>Salvar</button>
      <button type="button" data-mobile-preview-share>Preparar prévia para o celular</button>
      <button type="button" data-editor-restore>Restaurar itens removidos</button>
      <button type="button" data-editor-finish>Concluir edição</button>
    </div>
    <div class="editor-text-fields" data-editor-text-fields hidden aria-label="Textos do portfólio"></div>
    <p class="editor-help">Para editar a faixa que corre no topo, abra “Editar títulos e frases” e altere os campos “Faixa superior”. O botão fixo também pode ser renomeado ali. Para tirar um item, abra a seção dele e toque em “Remover”.</p>
    <div class="editor-uploads">
      <label>Trocar foto da capa<input type="file" accept="image/*" data-editor-cover /></label>
      <label>Trocar foto do contato<input type="file" accept="image/*" data-editor-contact /></label>
    </div>
    <section class="campaign-editor" data-campaign-editor aria-label="Editar edição especial">
      <h3>Edição especial</h3>
      <p>Prepare uma página própria para Black Friday, Natal, Dia das Mães ou outra ocasião.</p>
      <label class="campaign-toggle"><input type="checkbox" data-campaign-active /> Mostrar link no portfólio dentro do período</label>
      <label>Nome da edição<input type="text" data-campaign-name placeholder="Black Friday, Natal e Ano Novo..." /></label>
      <label>Chamada principal<input type="text" data-campaign-headline placeholder="Uma condição especial para sua marca" /></label>
      <label>Texto de apresentação<textarea rows="3" data-campaign-description placeholder="Escreva uma breve apresentação da edição"></textarea></label>
      <div class="campaign-dates">
        <label>Começa em<input type="date" data-campaign-start /></label>
        <label>Termina em<input type="date" data-campaign-end /></label>
      </div>
      <h4>Pacotes desta edição (até 3)</h4>
      {[1, 2, 3].map((number) => (
        <fieldset class="campaign-package" data-campaign-package={number - 1}>
          <legend>Pacote {String(number).padStart(2, '0')}</legend>
          <label>Nome<input type="text" data-package-name placeholder="Nome do pacote" /></label>
          <label>Detalhes<input type="text" data-package-detail placeholder="O que está incluído" /></label>
          <label>Preço (opcional)<input type="text" data-package-price placeholder="Deixe vazio se preferir informar no WhatsApp" /></label>
        </fieldset>
      ))}
      <button type="button" data-campaign-save>Salvar edição especial</button>
      <a href="/edicao-especial/" target="_blank" rel="noreferrer">Abrir página da edição especial</a>
    </section>
    <p class="editor-status" data-editor-status aria-live="polite">As mudanças ficam guardadas neste navegador. Para publicar, atualize o site.</p>
  </section>
</aside>

<script>
  const stateKey = 'deisyane-preview-editor-state-v1';
  const databaseName = 'deisyane-preview-editor-media-v1';
  const mobilePreviewToken = new URLSearchParams(location.search).get('mobile-preview');
  const sharedSnapshot = mobilePreviewToken ? await fetch(`/__preview_share/${encodeURIComponent(mobilePreviewToken)}/state`, { cache: 'no-store' }).then((response) => response.ok ? response.json() : null).catch(() => null) : null;
  const sharedState = sharedSnapshot?.state || null;
  const sharedMediaIds = new Set<string>(sharedSnapshot?.mediaIds || []);
  const editor = document.querySelector<HTMLElement>('[data-preview-editor]');
  const panel = editor?.querySelector<HTMLElement>('[data-editor-panel]');
  const status = editor?.querySelector<HTMLElement>('[data-editor-status]');
  const textButton = editor?.querySelector<HTMLButtonElement>('[data-editor-text]');
  const campaignDefaults = (() => {
    try { return JSON.parse(editor?.dataset.campaignDefaults || '{}'); } catch { return {}; }
  })() as { mostrar?: boolean; nome?: string; chamada?: string; texto?: string; botao?: string; inicio?: string; fim?: string; pacotes?: { nome?: string; detalhe?: string; preco?: string }[] };
  const state = (() => {
    if (sharedState) return sharedState;
    try { return JSON.parse(localStorage.getItem(stateKey) || '{"texts":{},"deleted":[],"orders":{},"media":[],"itemTexts":{},"niches":{},"customNiches":[]}'); }
    catch { return { texts: {}, deleted: [], orders: {}, media: [], itemTexts: {}, niches: {}, customNiches: [] }; }
  })() as {
    texts: Record<string, string>;
    deleted: string[];
    orders: Record<string, string[]>;
    itemTexts: Record<string, string>;
    niches: Record<string, string>;
    customNiches: { key: string; label: string }[];
    migrations?: string[];
    media: { id: string; kind: 'video' | 'photo' | 'logo' | 'testimonial'; name: string; niche: string; list: string }[];
    replacements: Record<string, string>;
    campaign?: { active: boolean; name: string; headline: string; description: string; start: string; end: string; packages: { name: string; detail: string; price: string }[] };
  };
  state.itemTexts ??= {};
  state.texts ??= {};
  state.niches ??= {};
  state.customNiches ??= [];
  state.media ??= [];
  state.orders ??= {};
  Object.entries(state.niches).forEach(([key, niche]) => { if (niche === 'todos') delete state.niches[key]; });
  Object.keys(state.itemTexts).forEach((key) => {
    if (key.endsWith(':format') && state.itemTexts[key] === 'Crie um nicho primeiro') state.itemTexts[key] = 'Outros';
  });
  state.media.forEach((media) => { if (media.kind === 'video' && media.niche === 'todos') media.niche = 'outros'; });
  state.replacements ??= {};
  state.campaign ??= {
    active: campaignDefaults.mostrar ?? false,
    name: campaignDefaults.nome ?? 'Black Friday',
    headline: campaignDefaults.chamada ?? '',
    description: campaignDefaults.texto ?? '',
    start: campaignDefaults.inicio ?? '',
    end: campaignDefaults.fim ?? '',
    packages: Array.from({ length: 3 }, (_, index) => ({
      name: campaignDefaults.pacotes?.[index]?.nome ?? '',
      detail: campaignDefaults.pacotes?.[index]?.detalhe ?? '',
      price: campaignDefaults.pacotes?.[index]?.preco ?? '',
    })),
  };
  state.campaign.packages = Array.from({ length: 3 }, (_, index) => state.campaign!.packages[index] ?? { name: '', detail: '', price: '' });
  state.migrations ??= [];
  if (!state.migrations.includes('testimonial-prints-v2')) {
    state.media.filter((media) => media.kind === 'testimonial').forEach((media) => {
      if (!state.deleted.includes(media.id)) state.deleted.push(media.id);
    });
    state.migrations.push('testimonial-prints-v2');
  }
  const normalizeMediaName = (name: string) => name.replace(/\s*\(\d+\)(?=\.[^.]+$)/, '').replace(/\.[^.]+$/, '').trim().toLocaleLowerCase();
  const namesAlreadyUsedAsLogos = new Set(state.media.filter((media) => media.kind === 'logo').map((media) => normalizeMediaName(media.name)));
  state.media.forEach((media) => {
    if (media.kind === 'photo' && namesAlreadyUsedAsLogos.has(normalizeMediaName(media.name)) && !state.deleted.includes(media.id)) state.deleted.push(media.id);
  });

  const saveState = () => {
    try { localStorage.setItem(stateKey, JSON.stringify(state)); return true; }
    catch { if (status) status.textContent = 'O navegador não conseguiu guardar o rascunho.'; return false; }
  };
  const openDatabase = () => new Promise<IDBDatabase>((resolve, reject) => {
    const request = indexedDB.open(databaseName, 1);
    request.onupgradeneeded = () => request.result.createObjectStore('media');
    request.onsuccess = () => resolve(request.result);
    request.onerror = () => reject(request.error);
  });
  const putFile = async (id: string, file: Blob) => {
    const db = await openDatabase();
    await new Promise<void>((resolve, reject) => {
      const transaction = db.transaction('media', 'readwrite');
      transaction.objectStore('media').put(file, id);
      transaction.oncomplete = () => resolve();
      transaction.onerror = () => reject(transaction.error);
    });
    db.close();
  };
  const deleteFile = async (id: string) => {
    const db = await openDatabase();
    await new Promise<void>((resolve, reject) => {
      const transaction = db.transaction('media', 'readwrite');
      transaction.objectStore('media').delete(id);
      transaction.oncomplete = () => resolve();
      transaction.onerror = () => reject(transaction.error);
    });
    db.close();
  };
  const deleteUploadedBrandLogo = async (id: string) => {
    const metadataKey = 'deisyane-preview-brand-logos-v1';
    const databaseName = 'deisyane-preview-brand-logo-files-v1';
    const logos = JSON.parse(localStorage.getItem(metadataKey) || '[]') as { id: string; name: string }[];
    localStorage.setItem(metadataKey, JSON.stringify(logos.filter((logo) => logo.id !== id)));
    const request = indexedDB.open(databaseName, 1);
    const db = await new Promise<IDBDatabase>((resolve, reject) => {
      request.onupgradeneeded = () => request.result.createObjectStore('logos');
      request.onsuccess = () => resolve(request.result);
      request.onerror = () => reject(request.error);
    });
    await new Promise<void>((resolve, reject) => {
      const transaction = db.transaction('logos', 'readwrite');
      transaction.objectStore('logos').delete(id);
      transaction.oncomplete = () => resolve();
      transaction.onerror = () => reject(transaction.error);
    });
    db.close();
  };
  const getFile = async (id: string) => {
    const db = await openDatabase();
    const file = await new Promise<Blob | undefined>((resolve, reject) => {
      const request = db.transaction('media').objectStore('media').get(id);
      request.onsuccess = () => resolve(request.result as Blob | undefined);
      request.onerror = () => reject(request.error);
    });
    db.close();
    if (file || !mobilePreviewToken || !sharedMediaIds.has(id)) return file;
    const response = await fetch(`/__preview_share/${encodeURIComponent(mobilePreviewToken)}/media/${encodeURIComponent(id)}`, { cache: 'no-store' }).catch(() => undefined);
    return response?.ok ? response.blob() : undefined;
  };
  let ffmpegPromise: Promise<import('@ffmpeg/ffmpeg').FFmpeg> | undefined;
  let videoConversionQueue = Promise.resolve();
  const videoConversions = new Map<string, Promise<File>>();
  let ffmpegErrorDetails: string[] = [];
  const loadVideoConverter = () => {
    if (!ffmpegPromise) ffmpegPromise = (async () => {
      const [{ FFmpeg }, assets] = await Promise.all([import('@ffmpeg/ffmpeg'), import('../lib/ffmpeg-assets')]);
      const ffmpeg = new FFmpeg();
      ffmpeg.on('log', ({ type, message }) => {
        if (type === 'stderr' && message.trim()) {
          ffmpegErrorDetails.push(message.trim());
          if (ffmpegErrorDetails.length > 12) ffmpegErrorDetails.shift();
        }
      });
      ffmpeg.on('progress', ({ progress }) => {
        if (Number.isFinite(progress) && progress > 0) {
          const message = `Preparando imagem do vídeo: ${Math.min(99, Math.round(progress * 100))}%.`;
          if (status) status.textContent = message;
          const overlay = document.querySelector<HTMLElement>('.video-conversion-overlay:not([hidden])');
          if (overlay) overlay.textContent = message;
        }
      });
      const decodeBase64 = (value: string) => Uint8Array.from(atob(value), (character) => character.charCodeAt(0));
      const coreURL = URL.createObjectURL(new Blob([decodeBase64(assets.ffmpegCoreBase64)], { type: 'text/javascript' }));
      const compressedWasm = new Blob([decodeBase64(assets.ffmpegWasmGzipBase64)]);
      const wasm = await new Response(compressedWasm.stream().pipeThrough(new DecompressionStream('gzip'))).blob();
      const wasmURL = URL.createObjectURL(wasm);
      try {
        await ffmpeg.load({ coreURL, wasmURL });
      } finally {
        URL.revokeObjectURL(coreURL);
        URL.revokeObjectURL(wasmURL);
      }
      return ffmpeg;
    })();
    return ffmpegPromise;
  };
  const transcodeToCompatibleMp4 = (source: Blob, filename: string, id: string, mobilePreview = false) => {
    const inProgress = videoConversions.get(id);
    if (inProgress) return inProgress;
    const convert = async () => {
      const ffmpeg = await loadVideoConverter();
      const extension = filename.split('.').pop()?.toLowerCase() || 'mov';
      const inputName = `compat-input-${id}.${extension}`;
      const outputName = `compat-output-${id}.mp4`;
      try {
        await ffmpeg.writeFile(inputName, new Uint8Array(await source.arrayBuffer()));
        ffmpegErrorDetails = [];
        const args = mobilePreview
          ? ['-i', inputName, '-map', '0:v:0', '-map', '0:a:0?', '-vf', "scale=w='min(720,iw)':h=-2:flags=lanczos", '-c:v', 'libx264', '-preset', 'ultrafast', '-crf', '24', '-maxrate', '1800k', '-bufsize', '3600k', '-pix_fmt', 'yuv420p', '-c:a', 'aac', '-b:a', '128k', '-movflags', '+faststart', outputName]
          : ['-i', inputName, '-map', '0:v:0', '-map', '0:a:0?', '-vf', "scale=w='min(1080,iw)':h=-2:flags=lanczos", '-c:v', 'libx264', '-preset', 'ultrafast', '-crf', '20', '-pix_fmt', 'yuv420p', '-c:a', 'aac', '-b:a', '160k', '-movflags', '+faststart', outputName];
        const exitCode = await ffmpeg.exec(args);
        if (exitCode !== 0) throw new Error(ffmpegErrorDetails.slice(-5).join(' ') || `A conversão terminou com o código ${exitCode}.`);
        const result = await ffmpeg.readFile(outputName);
        const bytes = result instanceof Uint8Array ? new Uint8Array(result) : new TextEncoder().encode(result);
        return new File([bytes], `${filename.replace(/\.[^.]+$/, '')}.mp4`, { type: 'video/mp4' });
      } finally {
        await Promise.all([inputName, outputName].map((name) => ffmpeg.deleteFile(name).catch(() => undefined)));
      }
    };
    const task = videoConversionQueue.then(convert, convert);
    videoConversions.set(id, task);
    videoConversionQueue = task.then(() => undefined, () => undefined);
    void task.finally(() => { if (videoConversions.get(id) === task) videoConversions.delete(id); }).catch(() => undefined);
    return task;
  };
  const trimLogoWhitespace = async (file: Blob): Promise<Blob> => {
    try {
      const source = await createImageBitmap(file);
      const canvas = document.createElement('canvas');
      canvas.width = source.width;
      canvas.height = source.height;
      const context = canvas.getContext('2d', { willReadFrequently: true });
      if (!context) return file;
      context.drawImage(source, 0, 0);
      const { data } = context.getImageData(0, 0, source.width, source.height);
      let left = source.width, top = source.height, right = -1, bottom = -1;
      for (let y = 0; y < source.height; y += 2) for (let x = 0; x < source.width; x += 2) {
        const offset = (y * source.width + x) * 4;
        const alpha = data[offset + 3];
        const nearWhite = data[offset] > 248 && data[offset + 1] > 248 && data[offset + 2] > 248;
        if (alpha < 24 || nearWhite) continue;
        left = Math.min(left, x); top = Math.min(top, y); right = Math.max(right, x); bottom = Math.max(bottom, y);
      }
      source.close();
      if (right < left || bottom < top) return file;
      const padX = Math.max(4, Math.round((right - left) * 0.035));
      const padY = Math.max(4, Math.round((bottom - top) * 0.12));
      left = Math.max(0, left - padX); top = Math.max(0, top - padY);
      right = Math.min(canvas.width - 1, right + padX); bottom = Math.min(canvas.height - 1, bottom + padY);
      const cropped = document.createElement('canvas');
      cropped.width = right - left + 1; cropped.height = bottom - top + 1;
      const croppedContext = cropped.getContext('2d');
      if (!croppedContext) return file;
      croppedContext.drawImage(canvas, left, top, cropped.width, cropped.height, 0, 0, cropped.width, cropped.height);
      return await new Promise<Blob>((resolve) => cropped.toBlob((blob) => resolve(blob || file), 'image/png'));
    } catch { return file; }
  };
  const optimizePhotoForCarousel = async (file: File): Promise<File> => {
    if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type)) return file;
    let bitmap: ImageBitmap | undefined;
    try {
      bitmap = await createImageBitmap(file);
      const scale = Math.min(1, 1200 / bitmap.width, 1600 / bitmap.height);
      if (scale === 1 && file.size < 500 * 1024) return file;
      const canvas = document.createElement('canvas');
      canvas.width = Math.max(1, Math.round(bitmap.width * scale));
      canvas.height = Math.max(1, Math.round(bitmap.height * scale));
      const context = canvas.getContext('2d');
      if (!context) return file;
      context.imageSmoothingQuality = 'high';
      context.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      const optimized = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/webp', 0.84));
      if (!optimized || optimized.size >= file.size) return file;
      return new File([optimized], file.name, { type: 'image/webp', lastModified: file.lastModified });
    } catch { return file; }
    finally { bitmap?.close(); }
  };
  const getPhotoDisplayFile = async (id: string, original: File): Promise<File> => {
    const cacheId = `${id}:carousel`;
    const cached = await getFile(cacheId).catch(() => undefined);
    if (cached) return cached instanceof File ? cached : new File([cached], original.name, { type: cached.type || 'image/webp' });
    const optimized = await optimizePhotoForCarousel(original);
    if (optimized !== original) await putFile(cacheId, optimized).catch(() => undefined);
    return optimized;
  };
    const setSlotImage = (slot: 'cover' | 'contact', file: Blob) => {
      const figure = document.querySelector<HTMLElement>(slot === 'cover' ? '.topo .foto' : '#contato .foto-contato');
      const oldImage = figure?.querySelector<HTMLImageElement>('img');
      if (!figure || !oldImage) return;
      const image = document.createElement('img');
      image.src = URL.createObjectURL(file);
      image.alt = oldImage.alt;
      image.loading = oldImage.loading;
      const picture = oldImage.closest('picture');
      if (picture) picture.replaceWith(image);
      else oldImage.replaceWith(image);
    };
    const setSlotFile = (input: HTMLInputElement, slot: 'cover' | 'contact') => {
      input.addEventListener('change', async () => {
        const file = input.files?.[0];
        if (!file) return;
        const id = `replacement-${slot}`;
        try {
          await putFile(id, file);
          state.replacements[slot] = id;
          setSlotImage(slot, file);
          saveState();
          if (status) status.textContent = 'Foto trocada e salva neste navegador.';
        } catch {
          if (status) status.textContent = 'Não foi possível guardar esta foto neste navegador.';
        }
        input.value = '';
      });
    };
    if (editor) {
      setSlotFile(editor.querySelector<HTMLInputElement>('[data-editor-cover]')!, 'cover');
      setSlotFile(editor.querySelector<HTMLInputElement>('[data-editor-contact]')!, 'contact');
      void (async () => {
        for (const slot of ['cover', 'contact'] as const) {
          const id = state.replacements[slot];
          if (!id) continue;
          const file = await getFile(id).catch(() => undefined);
          if (file) setSlotImage(slot, file);
        }
      })();
    }
  const cleanKey = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || 'outros';
  const setText = (element: HTMLElement, value: string) => {
    const key = element.dataset.previewText;
    const targets = key
      ? [...document.querySelectorAll<HTMLElement>(`[data-preview-text="${CSS.escape(key)}"]`)]
      : [element];
    for (const target of targets) {
      if (target.matches('.topo h1')) {
        const [first, ...rest] = value.trim().split(/\s+/);
        const emphasized = target.querySelector('em');
        if (emphasized) {
          target.childNodes[0].textContent = first || '';
          emphasized.textContent = rest.join(' ');
        } else target.textContent = value;
      } else if (target.matches('summary') && target.querySelector('span[aria-hidden="true"]')) {
        const firstText = [...target.childNodes].find((node) => node.nodeType === Node.TEXT_NODE);
        if (firstText) firstText.textContent = value;
      } else target.textContent = value;
    }
  };

  if (editor && panel) {
    if (mobilePreviewToken) editor.hidden = true;
    const shareButton = editor.querySelector<HTMLButtonElement>('[data-mobile-preview-share]');
    shareButton?.addEventListener('click', async () => {
      shareButton.disabled = true;
      if (status) {
        status.textContent = 'Preparando a prévia do celular…';
        status.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      const token = crypto.randomUUID();
      try {
        const brands: { id: string; name: string }[] = JSON.parse(localStorage.getItem('deisyane-preview-brand-logos-v1') || '[]');
        const brandFiles = await (async () => {
          const request = indexedDB.open('deisyane-preview-brand-logo-files-v1', 1);
          const db = await new Promise<IDBDatabase>((resolve, reject) => {
            request.onsuccess = () => resolve(request.result);
            request.onerror = () => reject(request.error);
          });
          const files = await Promise.all(brands.map(async (brand) => {
            const file = await new Promise<Blob | undefined>((resolve, reject) => {
              const read = db.transaction('logos').objectStore('logos').get(brand.id);
              read.onsuccess = () => resolve(read.result as Blob | undefined);
              read.onerror = () => reject(read.error);
            });
            return file ? { id: `brand-logo:${brand.id}`, file } : undefined;
          }));
          db.close();
          return files.filter((item): item is { id: string; file: Blob } => !!item);
        })();
        const stateResponse = await fetch(`/__preview_share/${token}/state`, {
          method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ state, brands: brands.filter((brand) => brandFiles.some((item) => item.id === `brand-logo:${brand.id}`)) }),
        });
        if (!stateResponse.ok) throw new Error('Não consegui preparar os dados da prévia.');
        const mediaIds = new Set<string>([
          ...state.media.filter((item) => !state.deleted.includes(item.id)).map((item) => item.id),
          ...Object.values(state.replacements).filter((id): id is string => typeof id === 'string' && !state.deleted.includes(id)),
        ]);
        let total = 0;
        const sharedVideosByHash = new Map<string, { id: string; posterId?: string }>();
        const makeVideoPoster = async (file: Blob): Promise<Blob | undefined> => {
          const objectUrl = URL.createObjectURL(file);
          const video = document.createElement('video');
          video.muted = true;
          video.preload = 'auto';
          video.src = objectUrl;
          try {
            await new Promise<void>((resolve, reject) => {
              video.addEventListener('loadedmetadata', () => {
                if (video.duration > 0.2) video.currentTime = Math.min(0.15, video.duration / 2);
                else resolve();
              }, { once: true });
              video.addEventListener('seeked', () => resolve(), { once: true });
              video.addEventListener('loadeddata', () => resolve(), { once: true });
              video.addEventListener('error', () => reject(new Error('Não consegui ler a imagem deste vídeo.')), { once: true });
            });
            if (!video.videoWidth || !video.videoHeight) return undefined;
            const canvas = document.createElement('canvas');
            const width = Math.min(540, video.videoWidth);
            canvas.width = width;
            canvas.height = Math.round(width * video.videoHeight / video.videoWidth);
            const context = canvas.getContext('2d');
            if (!context) return undefined;
            context.drawImage(video, 0, 0, canvas.width, canvas.height);
            return await new Promise<Blob | undefined>((resolve) => canvas.toBlob(resolve, 'image/jpeg', 0.86));
          } catch {
            return undefined;
          } finally {
            video.pause();
            video.removeAttribute('src');
            URL.revokeObjectURL(objectUrl);
          }
        };
        for (const id of mediaIds) {
          let file = await getFile(id).catch(() => undefined) || await getFile(`${id}:original`).catch(() => undefined);
          if (!file) continue;
          const record = state.media.find((media) => media.id === id);
          let posterBlob: Blob | undefined;
          let videoHash: string | undefined;
          if (record?.kind === 'video') {
            if (status) {
              status.textContent = `Preparando “${record.name}” para reproduzir em celulares. Isso pode levar alguns minutos…`;
              status.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
            try {
              const mobileCacheId = `${id}:mobile-preview`;
              const cachedMobileFile = await getFile(mobileCacheId).catch(() => undefined);
              if (cachedMobileFile) {
                file = cachedMobileFile instanceof File ? cachedMobileFile : new File([cachedMobileFile], `${record.name.replace(/\.[^.]+$/, '')}.mp4`, { type: 'video/mp4' });
              } else if (file.type !== 'video/mp4' || file.size > 8 * 1024 * 1024) {
                const pendingConversion = videoConversions.get(id);
                const source = pendingConversion ? await pendingConversion : file;
                file = await transcodeToCompatibleMp4(source, record.name, `${id}-mobile`, true);
                await putFile(mobileCacheId, file).catch(() => undefined);
              }
              let poster = await makeVideoPoster(file);
              if (!poster) {
                file = await transcodeToCompatibleMp4(file, record.name, `${id}-mobile`, true);
                await putFile(`${id}:mobile-preview`, file).catch(() => undefined);
                poster = await makeVideoPoster(file);
              }
              posterBlob = poster;
              const digest = await crypto.subtle.digest('SHA-256', await file.arrayBuffer());
              videoHash = [...new Uint8Array(digest)].map((byte) => byte.toString(16).padStart(2, '0')).join('');
            } catch (error) {
              console.warn('Não foi possível preparar este vídeo para celulares:', error);
            }
          }
          const previousVideo = videoHash ? sharedVideosByHash.get(videoHash) : undefined;
          if (previousVideo) {
            const aliasResponse = await fetch(`/__preview_share/${token}/media/${encodeURIComponent(id)}`, {
              method: 'PUT', headers: { 'x-preview-share-copy-from': previousVideo.id },
            });
            if (!aliasResponse.ok) throw new Error('Não consegui reutilizar um vídeo repetido na prévia.');
            if (previousVideo.posterId) {
              const posterAliasResponse = await fetch(`/__preview_share/${token}/media/${encodeURIComponent(`${id}:poster`)}`, {
                method: 'PUT', headers: { 'x-preview-share-copy-from': previousVideo.posterId },
              });
              if (posterAliasResponse.ok) total += 1;
            }
            total += 1;
            continue;
          }
          const response = await fetch(`/__preview_share/${token}/media/${encodeURIComponent(id)}`, {
            method: 'PUT', headers: { 'Content-Type': file.type || 'application/octet-stream' }, body: file,
          });
          if (!response.ok) throw new Error('Um dos arquivos não pôde ser incluído na prévia.');
          total += 1;
          if (videoHash) {
            let posterId: string | undefined;
            if (posterBlob) {
              posterId = `${id}:poster`;
              const posterResponse = await fetch(`/__preview_share/${token}/media/${encodeURIComponent(posterId)}`, {
                method: 'PUT', headers: { 'Content-Type': 'image/jpeg' }, body: posterBlob,
              });
              if (posterResponse.ok) total += 1;
              else posterId = undefined;
            }
            sharedVideosByHash.set(videoHash, { id, posterId });
          }
        }
        for (const { id, file } of brandFiles) {
          const response = await fetch(`/__preview_share/${token}/media/${encodeURIComponent(id)}`, {
            method: 'PUT', headers: { 'Content-Type': file.type || 'application/octet-stream' }, body: file,
          });
          if (!response.ok) throw new Error('Uma das logos das marcas não pôde ser incluída na prévia.');
          total += 1;
        }
        // Em uma prévia local, gere um endereço da rede Wi-Fi atual do computador.
        // Se o editor já estiver aberto por um endereço público, mantenha essa origem.
        let previewOrigin = location.origin;
        if (['localhost', '127.0.0.1', '::1'].includes(location.hostname)) {
