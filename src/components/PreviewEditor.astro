      const parent = document.querySelector<HTMLElement>(`#${list === 'videos' ? 'videos' : list === 'marcas' ? 'marcas' : list === 'resultados' ? 'resultados' : 'fotografias'} ${list === 'marcas' ? '.cartoes' : list === 'resultados' ? '[data-testimonial-prints]' : '.grade'}`);
