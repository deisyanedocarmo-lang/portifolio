    const hydrateMedia = async (includeDeleted = false) => {
      const seenIds = new Set<string>();
      const records = state.media.filter((media) => {
        if (seenIds.has(media.id)) return false;
        seenIds.add(media.id);
        return includeDeleted || !state.deleted.includes(media.id);
      });
      if (mobilePreviewToken && new URLSearchParams(location.search).get('preparar-videos') === '1') {
        try {
          const videosToPrepare = records.filter((media) => media.kind === 'video');
          if (videosToPrepare.length) {
            const ffmpeg = await loadVideoConverter();
            for (const [index, media] of videosToPrepare.entries()) {
              const original = await getFile(`${media.id}:original`) || await getFile(media.id);
              if (!original) throw new Error(`Não consegui abrir ${media.name}.`);
              const extension = media.name.split('.').pop()?.toLowerCase() || 'mov';
              const inputName = `preview-input-${media.id}.${extension}`;
              const outputName = `preview-output-${media.id}.mp4`;
              const posterName = `preview-poster-${media.id}.jpg`;
              await ffmpeg.writeFile(inputName, new Uint8Array(await original.arrayBuffer()));
              await ffmpeg.exec(['-i', inputName, '-map', '0:v:0', '-map', '0:a:0?', '-vf', "scale=w='min(1080,iw)':h=-2:flags=lanczos", '-c:v', 'libx264', '-preset', 'fast', '-crf', '20', '-pix_fmt', 'yuv420p', '-c:a', 'aac', '-b:a', '160k', '-movflags', '+faststart', outputName]);
              const converted = await ffmpeg.readFile(outputName);
              const bytes = converted instanceof Uint8Array ? new Uint8Array(converted) : new TextEncoder().encode(converted);
              const video = new File([bytes], `${media.name.replace(/\.[^.]+$/, '')}.mp4`, { type: 'video/mp4' });
              const videoResponse = await fetch(`/__preview_share/${encodeURIComponent(mobilePreviewToken)}/media/${encodeURIComponent(media.id)}`, { method: 'PUT', headers: { 'Content-Type': 'video/mp4' }, body: video });
              if (!videoResponse.ok) throw new Error(`Não consegui preparar ${media.name} para o celular.`);
              try {
                await ffmpeg.exec(['-ss', '0.15', '-i', outputName, '-frames:v', '1', '-vf', 'scale=540:-2', '-q:v', '4', posterName]);
                const posterData = await ffmpeg.readFile(posterName);
                const posterBytes = posterData instanceof Uint8Array ? new Uint8Array(posterData) : new TextEncoder().encode(posterData);
                const posterId = `${media.id}:poster`;
                const posterResponse = await fetch(`/__preview_share/${encodeURIComponent(mobilePreviewToken)}/media/${encodeURIComponent(posterId)}`, { method: 'PUT', headers: { 'Content-Type': 'image/jpeg' }, body: new Blob([posterBytes], { type: 'image/jpeg' }) });
                if (posterResponse.ok) sharedMediaIds.add(posterId);
              } catch { /* A capa é opcional quando o vídeo já está em MP4. */ }
              await Promise.all([inputName, outputName, posterName].map((name) => ffmpeg.deleteFile(name).catch(() => undefined)));
              console.info(`Vídeo ${index + 1} de ${videosToPrepare.length} preparado para celulares.`);
            }
          }
          const cleanUrl = new URL(location.href);
          cleanUrl.searchParams.delete('preparar-videos');
          history.replaceState(null, '', cleanUrl);
        } catch (error) {
          console.error('Não consegui preparar os vídeos desta prévia:', error);
        }
      }
      const remoteVideos = mobilePreviewToken ? records.filter((media) => media.kind === 'video') : [];
      for (const media of remoteVideos) {
        const parent = document.querySelector<HTMLUListElement>('#videos .grade');
        if (!parent || parent.querySelector(`[data-preview-media-key="${CSS.escape(media.id)}"]`)) continue;
        const node = document.createElement('li');
        node.dataset.videoItem = '';
        node.dataset.nicho = state.niches[media.id] || media.niche || 'outros';
        node.dataset.nichoLabel = nicheDisplayName(node.dataset.nicho, nicheOptions().find(([key]) => key === node.dataset.nicho)?.[1] || 'Outros');
        const figure = document.createElement('figure'); figure.className = 'video';
        const frame = document.createElement('div'); frame.className = 'moldura';
        const video = document.createElement('video'); video.dataset.src = `/__preview_share/${encodeURIComponent(mobilePreviewToken)}/media/${encodeURIComponent(media.id)}`; if (sharedMediaIds.has(`${media.id}:poster`)) video.poster = `/__preview_share/${encodeURIComponent(mobilePreviewToken)}/media/${encodeURIComponent(`${media.id}:poster`)}`; video.playsInline = true; video.setAttribute('playsinline', ''); video.setAttribute('webkit-playsinline', ''); video.preload = 'none'; video.setAttribute('aria-label', `Vídeo: ${media.name}`);
        const useNativeMobileControls = matchMedia('(pointer: coarse)').matches;
        if (useNativeMobileControls) {
          video.src = video.dataset.src;
          video.preload = 'metadata';
        }
        const playButton = document.createElement('button'); playButton.className = 'tocar'; playButton.type = 'button'; playButton.dataset.previewMobilePlay = ''; playButton.setAttribute('aria-label', `Tocar vídeo: ${state.itemTexts[`${media.id}:title`] || media.name}`);
        const circle = document.createElement('span'); circle.className = 'circulo'; circle.setAttribute('aria-hidden', 'true'); circle.textContent = '▶';
        playButton.addEventListener('click', () => {
          if (!video.src) { video.src = video.dataset.src || ''; video.load(); }
          video.controls = false;
          video.muted = false;
          video.loop = false;
          if (useNativeMobileControls) {
            const iosVideo = video as HTMLVideoElement & { webkitEnterFullscreen?: () => void };
            if (iosVideo.webkitEnterFullscreen) iosVideo.webkitEnterFullscreen();
            else if (video.requestFullscreen) void video.requestFullscreen().catch(() => {});
          }
          video.play().catch(() => { playButton.hidden = false; });
        });
        video.addEventListener('play', () => { figure.classList.add('video-playing'); playButton.hidden = true; });
        video.addEventListener('pause', () => { figure.classList.remove('video-playing'); if (!video.ended) playButton.hidden = false; });
        video.addEventListener('ended', () => { figure.classList.remove('video-playing'); playButton.hidden = false; });
        if (useNativeMobileControls) video.addEventListener('click', () => { if (!video.paused) video.pause(); });
        playButton.append(circle); frame.append(video, playButton);
        const caption = document.createElement('figcaption');
        const title = document.createElement('strong'); title.textContent = state.itemTexts[`${media.id}:title`] || media.name.replace(/\.[^.]+$/, '');
        const subtitle = document.createElement('span'); subtitle.textContent = state.itemTexts[`${media.id}:format`] || node.dataset.nichoLabel;
        caption.append(title, subtitle); figure.append(frame, caption); node.append(figure);
        const scopeName = [...(parent.querySelector<HTMLElement>('.video')?.getAttributeNames() || [])].find((name) => name.startsWith('data-astro-cid-'));
        if (scopeName) [node, figure, frame, video, playButton, circle, caption, title, subtitle].forEach((element) => element.setAttribute(scopeName, ''));
        node.dataset.previewMediaKey = media.id; node.dataset.previewMediaList = 'videos';
        addMediaTools(node, media.id); parent.append(node);
      }
      if (remoteVideos.length) window.dispatchEvent(new Event('video-filters-refresh'));
      const files = await Promise.all(records.filter((media) => !remoteVideos.includes(media)).map(async (media) => {
        const existing = document.querySelector<HTMLElement>(`[data-preview-media-key="${CSS.escape(media.id)}"]`);
        if (existing && media.kind !== 'testimonial') return { media, existing, file: undefined };
        let file: Blob | undefined;
        if (mobilePreviewToken && media.kind === 'photo' && sharedMediaIds.has(media.id)) {
          file = await fetch(`/__preview_share/${encodeURIComponent(mobilePreviewToken)}/media/${encodeURIComponent(media.id)}`, { cache: 'force-cache' })
            .then((response) => response.ok ? response.blob() : undefined).catch(() => undefined);
        }
        if (!file) file = media.kind === 'photo'
          ? (await getFile(`${media.id}:carousel`).catch(() => undefined)) || await getFile(media.id).catch(() => undefined)
          : await getFile(media.id).catch(() => undefined);
        if (file && !(file instanceof File)) file = new File([file], media.name || 'arquivo-do-portfolio', { type: file.type || 'application/octet-stream' });
        return { media, existing, file };
      }));
      for (const { media, existing, file: storedFile } of files) {
        let file = storedFile;
        if (existing) {
          if (media.kind === 'testimonial' && file) {
            const image = existing.querySelector<HTMLImageElement>('.print-imagem');
            if (image) { image.src = URL.createObjectURL(file); image.removeAttribute('srcset'); image.alt = media.name.replace(/\.[^.]+$/, '') || image.alt; }
          }
          continue;
        }
        if (file && media.kind === 'logo') {
          const cropped = await trimLogoWhitespace(file);
          const fileName = media.name.replace(/\.[^.]+$/, '') + '.png';
          file = new File([cropped], fileName, { type: 'image/png' });
          await putFile(media.id, file);
        }
        if (file && media.kind === 'photo') file = await getPhotoDisplayFile(media.id, file as File);
        if (file && media.kind === 'video' && file.type !== 'video/mp4') {
          // Se já existe uma versão MP4 pronta no armazenamento, use-a. Não volte
          // ao original MOV em cada abertura da prévia, pois isso reprocessa o vídeo
          // e deixa o card temporariamente sem imagem.
          const original = await getFile(`${media.id}:original`);
          const source = original || file;
          if (source.type !== 'video/mp4') {
            try {
              if (status) status.textContent = `Preparando “${media.name}” para mostrar a imagem…`;
              if (!original) { try { await putFile(`${media.id}:original`, source); } catch { /* Keep the source available in this session. */ } }
              file = await transcodeToCompatibleMp4(source, media.name, media.id);
              await putFile(media.id, file);
            } catch (error) {
              console.error('Não consegui adaptar o vídeo salvo:', error);
              file = source;
              const detail = error instanceof Error ? error.message : String(error);
              if (status) status.textContent = `Não consegui preparar a imagem de “${media.name}”. ${detail}`;
            }
          }
        }
        if (file) createCard(media.kind, file as File, media.id, URL.createObjectURL(file), media.niche);
      }
    };
    void hydrateMedia();

    const handleUpload = (input: HTMLInputElement, kind: 'video' | 'photo' | 'logo' | 'testimonial') => {
      input.addEventListener('change', async () => {
        let added = 0;
        let failed = 0;
        let uploadError = '';
        const selectedFiles = [...(input.files || [])];
        if (status && kind === 'video' && selectedFiles.length)
          status.textContent = selectedFiles.length === 1 ? `Incluindo “${selectedFiles[0].name}”…` : `Incluindo ${selectedFiles.length} vídeos…`;
        for (const file of selectedFiles) {
          const id = crypto.randomUUID();
          try {
            if (kind === 'logo') {
              const bitmap = await createImageBitmap(file);
              const readable = bitmap.width > 0 && bitmap.height > 0;
              bitmap.close();
              if (!readable) throw new Error('Imagem sem conteúdo legível');
            }
            const croppedLogo = kind === 'logo' ? await trimLogoWhitespace(file) : undefined;
            const videoTypeByExtension: Record<string, string> = {
              mp4: 'video/mp4', m4v: 'video/x-m4v', mov: 'video/quicktime',
              '3gp': 'video/3gpp', '3g2': 'video/3gpp2', webm: 'video/webm',
              avi: 'video/x-msvideo', mkv: 'video/x-matroska',
            };
            const extension = file.name.split('.').pop()?.toLowerCase() || '';
            const videoType = videoTypeByExtension[extension];
            const storedFile = croppedLogo
              ? new File([croppedLogo], file.name.replace(/\.[^.]+$/, '') + '.png', { type: 'image/png' })
              : kind === 'photo'
                ? await optimizePhotoForCarousel(file)
                : kind === 'video' && videoType && (!file.type || file.type === 'application/octet-stream')
                  ? new File([file], file.name, { type: videoType, lastModified: file.lastModified })
                  : file;
            let fileForCard = storedFile;
            if (kind === 'video') {
              // Salva o original e verifica se o navegador consegue mostrar a imagem.
              // Formatos incompatíveis são convertidos automaticamente no evento loadedmetadata.
              await putFile(id, storedFile);
              if (!createCard(kind, storedFile, id, URL.createObjectURL(storedFile), nicheSelect.value || 'outros')) throw new Error('Área de vídeos indisponível');
              added += 1;
              if (status) status.textContent = `Vídeo salvo. Verificando a imagem de “${file.name}”…`;
              continue;
            }
            const objectUrl = URL.createObjectURL(fileForCard);
            await putFile(id, storedFile);
            if (!createCard(kind, file, id, objectUrl, nicheSelect.value || 'outros')) throw new Error('Área de inclusão indisponível');
            added += 1;
          } catch (error) {
            uploadError = error instanceof Error ? error.message : 'Falha ao preparar o arquivo.';
            failed += 1;
          }
        }
        saveState();
        input.value = '';
        if (status) {
          if (failed && kind === 'logo') status.textContent = added
            ? `${added} logo(s) adicionada(s). ${failed} não abriu; tente PNG, JPG ou WEBP.`
            : 'Não consegui abrir essa logo. Tente enviar em PNG, JPG ou WEBP.';
          else if (failed) status.textContent = added
            ? `${added} arquivo(s) adicionado(s); ${failed} não foi(ram) aceito(s). ${uploadError}`
            : `Não consegui preparar o vídeo. ${uploadError}`;
          else if (added && kind === 'video') status.textContent = added === 1
            ? 'Vídeo salvo. Preparando a imagem…'
            : `${added} vídeos salvos. Preparando as imagens…`;
          else if (added) status.textContent = added === 1 ? 'Arquivo adicionado e salvo neste navegador.' : `${added} arquivos adicionados e salvos neste navegador.`;
        }
      });
    };
    handleUpload(editor.querySelector<HTMLInputElement>('[data-editor-video]')!, 'video');
    handleUpload(editor.querySelector<HTMLInputElement>('[data-editor-photo]')!, 'photo');
    handleUpload(editor.querySelector<HTMLInputElement>('[data-editor-logo]')!, 'logo');
    handleUpload(editor.querySelector<HTMLInputElement>('[data-editor-testimonial]')!, 'testimonial');

    editor.querySelector('[data-editor-restore]')?.addEventListener('click', async () => {
      state.deleted = [];
      await hydrateMedia(true);
      document.querySelectorAll<HTMLElement>('[data-preview-media-key]').forEach((node) => { delete node.dataset.previewRemoved; node.hidden = false; });
      document.querySelector<HTMLButtonElement>('[data-video-gallery] [data-filter].ativo')?.click();
      window.dispatchEvent(new Event('video-filters-refresh'));
      window.dispatchEvent(new Event('testimonial-order-updated'));
      refreshNicheSelects();
      saveState();
      if (status) status.textContent = 'Itens removidos restaurados.';
    });
  }
</script>

