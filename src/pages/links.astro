---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { c, caminho, endereco, linkDeContato, visual } from '../lib/site';

const base = endereco || Astro.url.origin;
const whatsapp = linkDeContato('whatsapp', 'Oi, Deisyane! Vim pelo seu link da bio e quero conversar.');
const cupons = c.linksBio.cupons;
const nome = c.topo.nome;
---

<Base
  visual={visual}
  pageTitle={`${nome} · Links`}
  pageDescription={c.linksBio.frase || c.topo.nicho}
  canonicalUrl={`${base}/links/`}
>
  <main class="links-page" id="conteudo">
    <div class="links-shell">
      <header class="perfil">
        <Picture
          src={c.topo.foto}
          alt={c.topo.fotoDescricao}
          widths={[320, 480, 640, 800]}
          sizes="(min-width: 600px) 25rem, 88vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
        />
        <p class="assinatura">{nome}</p>
        <p class="cargo">CREATOR UGC</p>
        <p class="frase">{c.linksBio.frase || c.topo.nicho}</p>
      </header>

      <nav class="atalhos" aria-label="Acessos rápidos">
        <a class="atalho principal" href={caminho('')}>Portfólio</a>
        {whatsapp && <a class="atalho" href={whatsapp} target="_blank" rel="noreferrer">WhatsApp</a>}
        {cupons.length > 0 && <a class="atalho" href="#cupons">Cupons</a>}
      </nav>

      {cupons.length > 0 && (
        <section class="cupons" id="cupons" aria-labelledby="cupons-titulo">
          <p class="rotulo">BENEFÍCIOS</p>
          <h1 id="cupons-titulo">Meus cupons</h1>
          <ul>
            {cupons.map((cupom) => (
              <li class="cupom">
                <div class="cupom-cabecalho">
                  <span class="marca">{cupom.marca}</span>
                  <span class="detalhe">{cupom.detalhe || 'Use meu cupom na loja.'}</span>
                </div>
                <div class="codigo-linha">
                  <code>{cupom.codigo}</code>
                  <button class="copiar" type="button" data-copiar={cupom.codigo}>Copiar</button>
                </div>
                <a class="loja" href={cupom.url} target="_blank" rel="noreferrer">Ver na loja <span aria-hidden="true">↗</span></a>
                <span class="aviso-copia" aria-live="polite"></span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <p class="assinatura-final">{nome} · UGC</p>
    </div>
  </main>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((button) => {
    button.addEventListener('click', async () => {
      const code = button.dataset.copiar || '';
      const status = button.closest('.cupom')?.querySelector<HTMLElement>('.aviso-copia');
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = 'Copiado';
        if (status) status.textContent = `Código ${code} copiado.`;
      } catch {
        if (status) status.textContent = `Código: ${code}. Toque e segure para copiar.`;
      }
      window.setTimeout(() => { button.textContent = 'Copiar'; }, 2200);
    });
  });
</script>

<style>
  .links-page {
    min-height: 100vh;
    padding: clamp(1.25rem, 4vw, 2rem) 1.1rem 2.25rem;
    background: linear-gradient(180deg, #f5efe7 0%, #fbf8f3 48%, var(--fundo) 100%);
  }
  .links-shell {
    width: min(100%, 31rem);
    margin-inline: auto;
  }
  .perfil {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .perfil :global(img) {
    width: 100%;
    height: auto;
    max-height: 27rem;
    aspect-ratio: 4 / 4.6;
    object-fit: cover;
    border: 1px solid rgb(75 53 43 / 10%);
    border-radius: 1.2rem;
    box-shadow: 0 1rem 2.5rem rgb(75 53 43 / 10%);
  }
  .assinatura {
    margin-top: 1.1rem;
    color: var(--marrom-profundo);
    font-family: var(--f-titulo);
    font-size: clamp(2.1rem, 8vw, 2.8rem);
    line-height: 1.05;
  }
  .cargo,
  .rotulo {
    color: var(--suave);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
  }
  .cargo { margin-top: 0.5rem; }
  .frase {
    max-width: 26rem;
    margin-top: 1.25rem;
    color: var(--suave);
    font-size: 1rem;
  }
  .atalhos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.55rem;
    margin-top: 1.45rem;
    padding: 0.55rem;
    border: 1px solid var(--linha);
    border-radius: 1.1rem;
    background: rgb(255 255 255 / 75%);
    box-shadow: 0 0.5rem 1.6rem rgb(75 53 43 / 5%);
  }
  .atalho {
    display: grid;
    min-height: 3.35rem;
    place-items: center;
    padding: 0.65rem 0.8rem;
    border: 1px solid transparent;
    border-radius: 0.75rem;
    color: var(--marrom-profundo);
    font-size: 0.94rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    transition: background-color 160ms ease, transform 160ms ease;
  }
  .atalho:hover { background: #f6f0e9; transform: translateY(-1px); }
  .atalho.principal { background: var(--marrom-profundo); color: #fff; }
  .atalho.principal:hover { background: #3c2a23; }
  .cupons { margin-top: 1.7rem; }
  .cupons h1 { margin-top: 0.45rem; color: var(--marrom-profundo); font-size: 2rem; }
  .cupons ul { display: grid; gap: 0.8rem; margin-top: 0.9rem; }
  .cupom {
    position: relative;
    padding: 1rem;
    border: 1px solid var(--linha);
    border-radius: 1rem;
    background: rgb(255 255 255 / 88%);
    box-shadow: 0 0.55rem 1.5rem rgb(75 53 43 / 5%);
  }
  .cupom-cabecalho { display: grid; gap: 0.15rem; }
  .marca { color: var(--marrom-profundo); font-weight: 700; }
  .detalhe { color: var(--suave); font-size: 0.88rem; }
  .codigo-linha {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
    margin-top: 0.9rem;
    padding: 0.55rem 0.6rem 0.55rem 0.85rem;
    border: 1px dashed #bba595;
    border-radius: 0.75rem;
    background: #fbf8f3;
  }
  .codigo-linha code {
    color: var(--marrom-profundo);
    font-family: var(--f-corpo);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .copiar {
    min-height: 2.45rem;
    padding: 0.45rem 0.8rem;
    border: 0;
    border-radius: 0.55rem;
    background: #e9ded3;
    color: var(--marrom-profundo);
    font: 600 0.83rem var(--f-corpo);
    cursor: pointer;
  }
  .copiar:hover { background: #dfd0c3; }
  .loja {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.9rem;
    margin-top: 0.6rem;
    padding: 0.5rem 0.7rem;
    border-radius: 0.65rem;
    background: var(--marrom-profundo);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }
  .loja:hover { background: #3c2a23; }
  .aviso-copia { display: block; min-height: 1.3rem; margin-top: 0.25rem; color: var(--suave); font-size: 0.76rem; }
  .assinatura-final { margin-top: 1rem; color: var(--suave); font-size: 0.73rem; text-align: center; }
  @media (min-width: 600px) {
    .links-page { display: grid; align-items: start; padding-block: 2.5rem; }
    .perfil :global(img) { max-height: 25rem; }
  }
</style>
