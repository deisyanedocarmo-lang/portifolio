---
// Página de links para a bio do Instagram: aviso de disponível, foto grande, botões em pílula,
// cupons e uma grade de fotos que leva para o portfólio.
import { existsSync } from 'node:fs';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { c, caminho, endereco, linkDeContato, visual } from '../lib/site';

const base = endereco || Astro.url.origin;
const nome = c.topo.nome;
const primeiroNome = nome.split(/\s+/)[0];
const cupons = c.linksBio.cupons;

const botoes = [
  c.campanha?.mostrar && { texto: `Quero conteúdos de ${c.campanha.nome}`, href: caminho('edicao-especial/'), destaque: true },
  { texto: 'Portfólio UGC', href: caminho('') },
  { texto: `Quero criar com a ${primeiroNome}`, href: linkDeContato('whatsapp', `Oi, ${primeiroNome}! Vim pelo seu link da bio e quero conversar sobre um conteúdo.`), externo: true },
  { texto: 'Instagram', href: linkDeContato('instagram'), externo: true },
  { texto: 'TikTok', href: linkDeContato('tiktok'), externo: true },
].filter((b): b is { texto: string; href: string; destaque?: boolean; externo?: boolean } => !!b && !!b.href);

// Até 6 fotos do portfólio, na versão leve.
const fotos = (c.fotografias?.mostrar ? c.fotografias.lista : []).slice(0, 6).map(({ arquivo, descricao }) => {
  const leve = arquivo.replace(/(-carrossel)?\.\w+$/, '-mini.webp');
  return { src: caminho(`fotografias/${existsSync(`public/fotografias/${leve}`) ? leve : arquivo}`), descricao };
});
---

<Base
  visual={visual}
  pageTitle={`${nome} · Links`}
  pageDescription={c.linksBio.frase || c.topo.nicho}
  canonicalUrl={`${base}/links/`}
>
  <main class="links-page" id="conteudo">
    <p class="disponivel"><span class="ponto" aria-hidden="true"></span>Disponível para novas campanhas</p>

    <header class="capa">
      <Picture
        src={c.linksBio.foto ?? c.topo.foto}
        alt={c.linksBio.foto ? (c.linksBio.fotoDescricao || c.topo.fotoDescricao) : c.topo.fotoDescricao}
        widths={[480, 720, 960]}
        sizes="(min-width: 600px) 32rem, 100vw"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
      />
      <div class="capa-texto">
        <p class="cargo">Creator UGC</p>
        <h1>{nome}</h1>
      </div>
    </header>

    <div class="links-shell">
      <nav class="botoes" aria-label="Links">
        {botoes.map((b) => (
          <a class:list={['botao-link', { destaque: b.destaque }]} href={b.href} target={b.externo ? '_blank' : undefined} rel={b.externo ? 'noreferrer' : undefined}>
            {b.texto}
          </a>
        ))}
      </nav>

      <section class="apresentacao" aria-label="Sobre">
        <p class="nome-espacado">{nome}</p>
        <p class="frase">{c.linksBio.frase}</p>
      </section>

      {fotos.length > 0 && (
        <a class="galeria" href={`${caminho('')}#fotografias`} aria-label="Ver todas as fotos no portfólio">
          {fotos.map((f) => <img src={f.src} alt={f.descricao} loading="lazy" decoding="async" width="520" height="650" />)}
        </a>
      )}

      {cupons.length > 0 && (
        <section class="cupons" id="cupons" aria-labelledby="cupons-titulo">
          <p class="rotulo">Benefícios</p>
          <h2 id="cupons-titulo">Meus cupons</h2>
          <ul>
            {cupons.map((cupom) => (
              <li class="cupom">
                <div class="cupom-cabecalho">
                  <span class="marca">{cupom.marca}</span>
                  <span class="detalhe">{cupom.detalhe || 'Use meu cupom na loja.'}</span>
                </div>
                <div class="codigo-linha">
                  <code>{cupom.codigo}</code>
                  <button class="copiar" type="button" data-copiar={cupom.codigo}>Copiar</button>
                </div>
                <a class="loja" href={cupom.url} target="_blank" rel="noreferrer">Ver na loja <span aria-hidden="true">↗</span></a>
                <span class="aviso-copia" aria-live="polite"></span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <p class="assinatura-final">{nome} · UGC</p>
    </div>
  </main>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((button) => {
    button.addEventListener('click', async () => {
      const code = button.dataset.copiar || '';
      const status = button.closest('.cupom')?.querySelector<HTMLElement>('.aviso-copia');
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = 'Copiado';
        if (status) status.textContent = `Código ${code} copiado.`;
      } catch {
        if (status) status.textContent = `Código: ${code}. Toque e segure para copiar.`;
      }
      window.setTimeout(() => { button.textContent = 'Copiar'; }, 2200);
    });
  });
</script>

<style>
  .links-page {
    width: min(100%, 32rem);
    min-height: 100vh;
    margin-inline: auto;
    padding-bottom: 2.25rem;
    background: var(--fundo-suave);
  }
  /* Faixa do alto: aviso de disponível. */
  .disponivel {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin: 0;
    padding: 0.75rem 1rem;
    background: var(--marrom-profundo);
    color: #f7f1ea;
    font-family: var(--f-titulo);
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .ponto {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: #9cbf8f;
    box-shadow: 0 0 0 0 rgb(156 191 143 / 60%);
    animation: pulsar 2.2s ease-out infinite;
  }
  @keyframes pulsar { 70% { box-shadow: 0 0 0 0.45rem rgb(156 191 143 / 0%); } 100% { box-shadow: 0 0 0 0 rgb(156 191 143 / 0%); } }
  /* Foto grande, com o nome por cima e um degradê que funde com o fundo. */
  .capa { position: relative; }
  .capa :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 4.4;
    object-fit: cover;
    object-position: center 22%;
  }
  .capa::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 55%;
    background: linear-gradient(180deg, transparent, rgb(75 53 43 / 82%));
    pointer-events: none;
  }
  .capa-texto {
    position: absolute;
    z-index: 1;
    inset: auto 0 1.4rem;
    text-align: center;
    color: #fff;
  }
  .cargo {
    margin: 0 0 0.35rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    opacity: 0.88;
  }
  .capa h1 {
    margin: 0;
    color: #fff;
    font-family: var(--f-titulo);
    font-size: clamp(2.2rem, 10vw, 3rem);
    font-weight: 400;
    line-height: 1;
  }
  .links-shell { padding: 1.5rem 1.15rem 0; }
  /* Botões em pílula. */
  .botoes { display: grid; gap: 0.75rem; }
  .botao-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 3.4rem;
    padding: 0.8rem 1.25rem;
    border: 1px solid var(--marrom-profundo);
    border-radius: 999px;
    background: var(--marrom-profundo);
    color: #f7f1ea;
    font-family: var(--f-titulo);
    font-size: 0.86rem;
    letter-spacing: 0.15em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform 0.18s ease, background-color 0.18s ease, box-shadow 0.18s ease;
  }
  .botao-link:hover { transform: translateY(-2px); box-shadow: 0 0.6rem 1.4rem rgb(75 53 43 / 18%); }
  .botao-link:active { transform: scale(0.98); }
  .botao-link.destaque { border-color: var(--nude); background: var(--nude); color: var(--marrom-profundo); }
  .botao-link.contorno { background: transparent; color: var(--marrom-profundo); }
  .botao-link:focus-visible { outline: 2px solid var(--destaque); outline-offset: 3px; }
  /* Nome espaçado e nicho. */
  .apresentacao { margin-top: 2.6rem; text-align: center; }
  .nome-espacado {
    margin: 0;
    color: var(--texto);
    font-family: var(--f-titulo);
    font-size: 1.05rem;
    letter-spacing: 0.35em;
  }
  .nicho {
    margin: 0.35rem 0 0;
    color: var(--marrom-profundo);
    font-family: var(--f-titulo);
    font-size: clamp(1.25rem, 5.4vw, 1.6rem);
    line-height: 1.25;
  }
  .frase { margin: 0.6rem auto 0; max-width: 24rem; color: var(--suave); font-size: 0.95rem; }
  /* Grade de fotos que leva ao portfólio. */
  .galeria {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.4rem;
    margin-top: 1.4rem;
  }
  .galeria img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 0.4rem;
    background: var(--nude);
  }
  /* Cupons. */
  .cupons { margin-top: 2.2rem; }
  .rotulo {
    margin: 0;
    color: var(--suave);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .cupons h2 { margin-top: 0.45rem; color: var(--marrom-profundo); font-size: 2rem; }
  .cupons ul { display: grid; gap: 0.8rem; margin-top: 0.9rem; padding: 0; list-style: none; }
  .cupom {
    position: relative;
    padding: 1rem;
    border: 1px solid var(--linha);
    border-radius: 1rem;
    background: var(--superficie);
    box-shadow: 0 0.55rem 1.5rem rgb(75 53 43 / 5%);
  }
  .cupom-cabecalho { display: grid; gap: 0.15rem; }
  .marca { color: var(--marrom-profundo); font-weight: 700; }
  .detalhe { color: var(--suave); font-size: 0.88rem; }
  .codigo-linha {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
    margin-top: 0.9rem;
    padding: 0.55rem 0.6rem 0.55rem 0.85rem;
    border: 1px dashed #bba595;
    border-radius: 0.75rem;
    background: var(--fundo-suave);
  }
  .codigo-linha code {
    color: var(--marrom-profundo);
    font-family: var(--f-corpo);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .copiar {
    min-height: 2.45rem;
    padding: 0.45rem 0.8rem;
    border: 0;
    border-radius: 999px;
    background: #e9ded3;
    color: var(--marrom-profundo);
    font: 600 0.83rem var(--f-corpo);
    cursor: pointer;
  }
  .copiar:hover { background: #dfd0c3; }
  .loja {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.9rem;
    margin-top: 0.6rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--marrom-profundo);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }
  .loja:hover { background: #3c2a23; }
  .aviso-copia { display: block; min-height: 1.3rem; margin-top: 0.25rem; color: var(--suave); font-size: 0.76rem; }
  .assinatura-final { margin-top: 1rem; color: var(--suave); font-size: 0.73rem; text-align: center; }
  @media (max-width: 420px) { .botao-link { font-size: 0.8rem; letter-spacing: 0.1em; padding-inline: 1rem; } }
  @media (prefers-reduced-motion: reduce) { .ponto { animation: none; } }
  @media (min-width: 600px) {
    .links-page { margin-block: 1.5rem; border-radius: 1.25rem; overflow: hidden; box-shadow: 0 1rem 3rem rgb(75 53 43 / 12%); }
  }
</style>
